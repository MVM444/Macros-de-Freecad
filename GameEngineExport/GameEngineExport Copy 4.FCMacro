    # ----------------- UI handlers -----------------

    def _wrap(self, layout):
        w = QtWidgets.QWidget()
        w.setLayout(layout)
        return w

    def _on_take_root(self):
        sel = Gui.Selection.getSelection()
        if sel:
            self.ed_root.setText(sel[0].Name)
        else:
            self.ed_root.clear()
        self._populate_available()

    def _on_add(self):
        for it in self.lst_available.selectedItems():
            name = it.data(QtCore.Qt.UserRole)
            if not self._exists_in(self.lst_selected, name):
                new = QtWidgets.QListWidgetItem(it.text())
                new.setData(QtCore.Qt.UserRole, name)
                self.lst_selected.addItem(new)

    def _on_remove(self):
        for it in list(self.lst_selected.selectedItems()):
            self.lst_selected.takeItem(self.lst_selected.row(it))

    def _on_clear_selected_list(self):
        self.lst_selected.clear()

    def _on_browse_out(self):
        d = QtWidgets.QFileDialog.getExistingDirectory(self, "Seleccione carpeta de export")
        if d:
            self.ed_out_folder.setText(d)

    def _on_browse_cge(self):
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Seleccione ejecutable de CGE", "", "Exe (*.exe);;All (*.*)")
        if path:
            self.ed_cge.setText(path)

    def _on_pick_color(self):
        col = QtWidgets.QColorDialog.getColor(self._get_color(), self, "Color de luz")
        if col.isValid():
            self._set_color(col)

    def _on_set_solar_local(self):
        self._set_solar_from_time(None)  # usa hora local del sistema

    def _on_set_solar_picktime(self):
        now = datetime.now()
        dlg = TimePickerDialog(self, initial=(now.hour, now.minute))
        if dlg.exec_() == QtWidgets.QDialog.Accepted:
            hh, mm = dlg.get_hm()
            self._set_solar_from_time((hh, mm))

    def _set_solar_from_time(self, hm_tuple):
        try:
            lat = float(self.spn_lat.value())
        except:
            lat = 0.0

        if hm_tuple is None:
            now = datetime.now()
            hour = now.hour + now.minute/60.0 + now.second/3600.0
            doy = now.timetuple().tm_yday
        else:
            now = datetime.now()
            hour = float(hm_tuple[0]) + float(hm_tuple[1])/60.0
            doy = now.timetuple().tm_yday

        # declinacion aprox
        decl = 23.44 * math.sin(math.radians((360.0/365.0) * (284 + doy)))
        H = 15.0 * (hour - 12.0)  # deg relativo al mediodia
        latr = math.radians(lat); decr = math.radians(decl); Hr = math.radians(H)
        sin_alt = math.sin(latr)*math.sin(decr) + math.cos(latr)*math.cos(decr)*math.cos(Hr)
        sin_alt = max(-1.0, min(1.0, sin_alt))
        alt = math.degrees(math.asin(sin_alt))
        cos_alt = max(1e-6, math.cos(math.radians(alt)))
        sinA = -math.sin(Hr)*math.cos(decr)/cos_alt
        cosA = (math.sin(decr) - math.sin(latr)*math.sin(math.radians(alt))) / (math.cos(latr)*cos_alt)
        A = math.degrees(math.atan2(sinA, cosA))
        if A < 0: A += 360.0
        yaw = A
        pitch = -alt

        self.chk_gl.setChecked(True)
        self.spn_gl_int.setValue(1.2)
        self._set_color(QtGui.QColor(255,255,255))
        self.spn_gl_yaw.setValue(yaw)
        self.spn_gl_pitch.setValue(pitch)
        src = "local" if hm_tuple is None else f"{int(hm_tuple[0]):02d}:{int(hm_tuple[1]):02d}"
        log_info(f"Luz solar: lat={lat:.2f} doy={doy} hora={hour:.2f} ({src}) -> alt={alt:.1f} azim={A:.1f}, yaw={yaw:.1f} pitch={pitch:.1f}")

    def _on_create_gamestart(self):
        name = self.ed_gs.text().strip() or "GameStart"
        if name in self.doc.Objects:
            self.lbl_gs.setText("Ya existe")
            self._update_gamestart_status()
            return
        try:
            obj = self.doc.addObject("App::Part", name)
            obj.Label = name
            # propiedades utiles (opcionales)
            if not hasattr(obj, "Yaw"):
                obj.addProperty("App::PropertyFloat","Yaw","GameEngine","yaw deg").Yaw = 0.0
            if not hasattr(obj, "Pitch"):
                obj.addProperty("App::PropertyFloat","Pitch","GameEngine","pitch deg").Pitch = 0.0
            if not hasattr(obj, "Roll"):
                obj.addProperty("App::PropertyFloat","Roll","GameEngine","roll deg").Roll = 0.0
            if not hasattr(obj, "HeightOffset"):
                obj.addProperty("App::PropertyFloat","HeightOffset","GameEngine","eye height m").HeightOffset = 1.6
            if not hasattr(obj, "FOV"):
                obj.addProperty("App::PropertyFloat","FOV","GameEngine","fov rad").FOV = 1.047197551
            self.doc.recompute()
            self.lbl_gs.setText("Creado")
        except Exception as ex:
            log_err(f"Create GameStart failed: {ex}")
            self.lbl_gs.setText("Error")
        self._update_gamestart_status()
        self._populate_available()

    def _update_gamestart_status(self):
        name = self.ed_gs.text().strip() or "GameStart"
        if name in self.doc.Objects:
            self.lbl_gs.setText("Existe")
        else:
            self.lbl_gs.setText("")

    # ----------------- Core -----------------

    def _populate_available(self):
        self.lst_available.clear()
        objs = []
        root = self.ed_root.text().strip()
        if root:
            obj = self._find_obj(root)
            if obj:
                objs = self._walk(obj)
        else:
            objs = list(self.doc.Objects)

        def is_exportable(o):
            if hasattr(o, "Shape") and o.Shape and not o.Shape.isNull():
                if hasattr(o, "ViewObject") and o.ViewObject.Visibility is False:
                    return False
                return True
            if hasattr(o, "Mesh") and o.Mesh:
                if hasattr(o, "ViewObject") and o.ViewObject.Visibility is False:
                    return False
                return True
            return False

        labels = []
        for o in objs:
            if is_exportable(o):
                labels.append((o.Label, o.Name))

        labels.sort(key=lambda x: x[0].lower())
        for lbl, name in labels:
            if self._exists_in(self.lst_selected, name):
                continue
            it = QtWidgets.QListWidgetItem(lbl)
            it.setData(QtCore.Qt.UserRole, name)
            self.lst_available.addItem(it)

    def _exists_in(self, listw, obj_name):
        for i in range(listw.count()):
            it = listw.item(i)
            if it.data(QtCore.Qt.UserRole) == obj_name:
                return True
        return False

    def _find_obj(self, name_or_label):
        o = self.doc.getObject(name_or_label)
        if o: return o
        for x in self.doc.Objects:
            if getattr(x, "Label", "") == name_or_label:
                return x
        return None

    def _walk(self, root):
        out = []
        try:
            for c in root.OutList:
                out.append(c)
                out.extend(self._walk(c))
        except Exception:
            pass
        return out

    def _get_color(self):
        pal = self.frm_gl_color.palette()
        return pal.color(QtGui.QPalette.Window)

    def _set_color(self, qcolor):
        pal = self.frm_gl_color.palette()
        pal.setColor(QtGui.QPalette.Window, qcolor)
        self.frm_gl_color.setPalette(pal)
        self.frm_gl_color.update()

    def _launch_cge(self, x3d_path):
        exe = self.ed_cge.text().strip()
        if not exe or not os.path.isfile(exe):
            log_warn("Ruta de CGE invalida.")
            return False
        if not os.path.isfile(x3d_path):
            log_warn("Archivo X3D no existe para lanzar CGE.")
            return False
        try:
            subprocess.Popen([exe, x3d_path])
            return True
        except Exception as ex:
            log_err(f"Lanzar CGE fallo: {ex}")
            return False

    def _on_export(self):
        try:
            folder = self.ed_out_folder.text().strip()
            base = self.ed_base.text().strip()
            if not folder or not os.path.isdir(folder):
                QtWidgets.QMessageBox.warning(self, "Exportar X3D", "Seleccione carpeta valida.")
                return
            if not base:
                QtWidgets.QMessageBox.warning(self, "Exportar X3D", "Indique nombre base.")
                return
            x3d_path = os.path.join(folder, base + ".x3d")
            if os.path.exists(x3d_path) and self.chk_confirm_over.isChecked():
                r = QtWidgets.QMessageBox.question(
                    self, "Sobrescribir archivo",
                    "El archivo ya existe:\n{}\n\nDesea sobrescribirlo?".format(x3d_path),
                    QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
                    QtWidgets.QMessageBox.No
                )
                if r != QtWidgets.QMessageBox.Yes:
                    return

            export_objs = []
            for i in range(self.lst_selected.count()):
                name = self.lst_selected.item(i).data(QtCore.Qt.UserRole)
                o = self.doc.getObject(name)
                if o: export_objs.append(o)
            if not export_objs:
                QtWidgets.QMessageBox.warning(self, "Exportar X3D", "No hay objetos seleccionados.")
                return

            original = {}
            temp_objs = []
            z_shift = 0.0

            if self.chk_baseline.isChecked():
                zmin = None
                for o in export_objs:
                    if hasattr(o, "Shape") and o.Shape and not o.Shape.isNull():
                        bb = o.Shape.BoundBox
                        if zmin is None or bb.ZMin < zmin:
                            zmin = bb.ZMin
                if zmin is not None and abs(zmin) > 1e-6:
                    z_shift = -zmin

            if self.chk_freeze.isChecked():
                for o in export_objs:
                    if hasattr(o, "Shape") and o.Shape and not o.Shape.isNull():
                        new = self.doc.addObject("Part::Feature", f"Export_{o.Name}")
                        plc = o.Placement
                        basev = App.Vector(plc.Base.x, plc.Base.y, plc.Base.z + z_shift)
                        new_plc = App.Placement(basev, plc.Rotation)
                        M = new_plc.toMatrix()
                        new.Shape = o.Shape.transformed(M, True)
                        new.Placement = App.Placement()
                        temp_objs.append(new)
                    else:
                        temp_objs.append(o)
                to_export = temp_objs[:]
            else:
                if abs(z_shift) > 1e-9:
                    for o in export_objs:
                        if hasattr(o, "Placement"):
                            original[o.Name] = o.Placement.copy()
                            plc = o.Placement
                            o.Placement = App.Placement(
                                App.Vector(plc.Base.x, plc.Base.y, plc.Base.z + z_shift),
                                plc.Rotation
                            )
                if self.chk_triang.isChecked():
                    import Mesh, MeshPart
                    for o in export_objs:
                        if hasattr(o, "Shape") and o.Shape and not o.Shape.isNull():
                            m = self.doc.addObject("Mesh::Feature", f"Mesh_{o.Name}")
                            m.Mesh = MeshPart.meshFromShape(Shape=o.Shape, LinearDeflection=0.1, AngularDeflection=15, Relative=False)
                            m.Placement = o.Placement
                            temp_objs.append(m)
                        else:
                            temp_objs.append(o)
                    to_export = temp_objs[:]
                else:
                    to_export = export_objs[:]

            Gui.export(to_export, x3d_path)
            log_info(f"Exported X3D: {x3d_path}")

            if original:
                for nm, plc in original.items():
                    obj = self.doc.getObject(nm)
                    if obj: obj.Placement = plc

            for t in temp_objs:
                if t.Document is self.doc and (t.Name.startswith("Export_") or t.Name.startswith("Mesh_")):
                    try:
                        self.doc.removeObject(t.Name)
                    except Exception:
                        pass
            self.doc.recompute()

            # post-proceso: mm->m, background, navigation, luz, viewpoint
            self._decorate_x3d(x3d_path)

            self._save_session_config()

            if self.chk_run_cge.isChecked():
                ok = self._launch_cge(x3d_path)
                if not ok:
                    QtWidgets.QMessageBox.warning(self, "CGE", "No se pudo ejecutar Castle Game Engine. Verifique la ruta en Config & Perfiles.")

            QtWidgets.QMessageBox.information(self, "Exportar X3D", "Exportacion completada:\n" + x3d_path)

        except Exception:
            import traceback
            log_err("Export failed:\n" + traceback.format_exc())
            QtWidgets.QMessageBox.critical(self, "Exportar X3D", "Fallo la exportacion. Revise la consola.")

    def _decorate_x3d(self, x3d_path):
        """
        Post-proceso del X3D:
        - Inserta Background y NavigationInfo con avatar en metros.
        - Envuelve contenido de <Scene> con Transform DEF="FreeCAD_mm_to_m" scale="0.001 0.001 0.001" (mm->m) si no existe.
        - Inserta DirectionalLight (si activo) y Viewpoint desde GameStart (si existe), en METROS.
        """
        if not os.path.isfile(x3d_path):
            log_warn("X3D no existe para decorar.")
            return
        try:
            with open(x3d_path, "r", encoding="utf-8") as f:
                content = f.read()

            if 'DEF="FreeCAD_mm_to_m"' in content:
                mm_wrapper_present = True
            else:
                mm_wrapper_present = False

            si = content.find("<Scene")
            if si == -1:
                log_warn("No se encontro <Scene> en el X3D.")
                return
            open_end = content.find(">", si)
            if open_end == -1:
                log_warn("Scene sin cierre de tag '>'")
                return
            ci = content.find("</Scene>")
            if ci == -1:
                log_warn("No se encontro </Scene> en el X3D.")
                return

            scene_open = content[:open_end+1]
            scene_body = content[open_end+1:ci]
            scene_close = content[ci:]
            indent = "  "

            avatar_collision = 0.25
            avatar_step = 0.75
            avatar_eye = 1.6
            nav_speed = 2.0
            background = f'{indent}<Background skyColor="0.2 0.4 1.0" groundColor="0.4 0.2 0.1"/>'
            navigation = (f"{indent}<NavigationInfo avatarSize=\"{avatar_collision} {avatar_step} {avatar_eye}\" "
                          f"speed=\"{nav_speed}\" headlight=\"false\" type='\"WALK\" \"ANY\"'/>")

            dir_line = ""
            if self.chk_gl.isChecked():
                yaw = math.radians(self.spn_gl_yaw.value())
                pitch = math.radians(self.spn_gl_pitch.value())
                dx = math.sin(yaw) * math.cos(pitch)
                dy = -math.cos(yaw) * math.cos(pitch)
                dz = -math.sin(pitch)
                intensity = float(self.spn_gl_int.value())
                col = self._get_color()
                r, g, b = col.red()/255.0, col.green()/255.0, col.blue()/255.0
                dir_line = (f'{indent}<DirectionalLight intensity="{intensity:.3f}" '
                            f'color="{r:.3f} {g:.3f} {b:.3f}" '
                            f'direction="{dx:.6f} {dy:.6f} {dz:.6f}"/>')

            vp_line = ""
            gs = self.ed_gs.text().strip() or "GameStart"
            if gs in self.doc.Objects:
                obj = self.doc.getObject(gs)
                plc = obj.Placement
                tx_m, ty_m, tz_m = plc.Base.x * 0.001, plc.Base.y * 0.001, plc.Base.z * 0.001
                axis = plc.Rotation.Axis
                ang = plc.Rotation.Angle
                rot_attr = f' orientation="{axis.x:.6f} {axis.y:.6f} {axis.z:.6f} {ang:.6f}"' if abs(ang) > 1e-6 else ""
                # usa FOV del objeto si existe
                fov = getattr(obj, "FOV", 1.047197551)
                try:
                    fov = float(fov)
                except:
                    fov = 1.047197551
                vp_line = (f'{indent}<Viewpoint DEF="{gs}_VP" position="{tx_m:.3f} {ty_m:.3f} {tz_m:.3f}"{rot_attr} '
                           f'fieldOfView="{fov:.6f}" description="GameStart"/>')

            head_block_lines = [background, navigation]
            if dir_line:
                head_block_lines.append(dir_line)
            if not mm_wrapper_present:
                head_block_lines.append(f'{indent}<Transform DEF="FreeCAD_mm_to_m" scale="0.001 0.001 0.001">')
                tail_block = f"\n{indent}</Transform>\n"
            else:
                tail_block = ""
            if vp_line:
                head_block_lines.append(vp_line)

            head_block = "\n" + "\n".join(head_block_lines) + "\n"

            if not mm_wrapper_present:
                new_body = head_block + scene_body + tail_block
            else:
                new_body = head_block + scene_body

            new_content = scene_open + new_body + scene_close

            with open(x3d_path, "w", encoding="utf-8") as f:
                f.write(new_content)

            log_info("X3D decorado: background, navigation, escala mm->m, luz global y Viewpoint aplicados.")
        except Exception as ex:
            log_warn(f"No se pudo decorar X3D: {ex}")

    # ----------------- Persistencia -----------------

    def _load_settings(self):
        p = get_param()
        project_name = os.path.splitext(os.path.basename(self.doc.FileName))[0] if self.doc.FileName else None
        sidecar = os.path.join(os.path.dirname(self.doc.FileName), f"{project_name}.gee.json") if project_name else ""
        loaded_json = False

        if sidecar and os.path.isfile(sidecar):
            try:
                with open(sidecar, "r", encoding="utf-8") as f:
                    data = json.load(f)
                self.ed_root.setText(data.get("root",""))
                self.ed_out_folder.setText(data.get("outputFolder", os.path.dirname(self.doc.FileName) if self.doc.FileName else ""))
                self.ed_base.setText(data.get("baseFilename", project_name or "Export"))
                self.lst_selected.clear()
                for nm in data.get("exportedObjects", []):
                    o = self.doc.getObject(nm)
                    if o:
                        it = QtWidgets.QListWidgetItem(o.Label)
                        it.setData(QtCore.Qt.UserRole, o.Name)
                        self.lst_selected.addItem(it)
                gl = data.get("globalLight", {})
                self.chk_gl.setChecked(bool(gl.get("enabled", False)))
                self.spn_gl_int.setValue(float(gl.get("intensity", 1.2)))
                col = gl.get("color", [255,255,255])
                if isinstance(col, list) and len(col)==3:
                    self._set_color(QtGui.QColor(int(col[0]), int(col[1]), int(col[2])))
                self.spn_gl_yaw.setValue(float(gl.get("yaw", 135.0)))
                self.spn_gl_pitch.setValue(float(gl.get("pitch", -35.0)))
                gs = data.get("gameStart", {})
                self.ed_gs.setText(gs.get("name", p.GetString("DefaultGameStartName","GameStart")))
                opt = data.get("options", {})
                self.chk_triang.setChecked(bool(opt.get("triangulate", False)))
                self.chk_freeze.setChecked(bool(opt.get("freeze", False)))
                self.chk_baseline.setChecked(bool(opt.get("autoBaseline", False)))
                self.ed_cge.setText(data.get("CGE_path", p.GetString("CGE_Path","")))
                self.chk_run_cge.setChecked(bool(data.get("AutoLaunchCGE", p.GetBool("AutoLaunchCGE", False))))
                self.ed_default_gs.setText(data.get("defaultGameStartName", p.GetString("DefaultGameStartName","GameStart")))
                self.chk_confirm_over.setChecked(bool(data.get("confirmOverwrite", p.GetBool("ConfirmOverwrite", True))))
                self.spn_lat.setValue(float(data.get("solarLatitude", p.GetFloat("SolarLatitude", 9.9))))
                loaded_json = True
                log_info("Config del archivo cargada desde sidecar (.gee.json)")
            except Exception as ex:
                log_warn(f"No se pudo cargar sidecar: {ex}")

        if not loaded_json:
            self.ed_root.setText(p.GetString("RootObject",""))
            self.ed_out_folder.setText(p.GetString("OutputFolder", os.path.dirname(self.doc.FileName) if self.doc.FileName else ""))
            project_name = os.path.splitext(os.path.basename(self.doc.FileName))[0] if self.doc.FileName else "Export"
            self.ed_base.setText(p.GetString("BaseFileName", project_name))
            self.lst_selected.clear()
            sel_csv = p.GetString("ExportList","")
            if sel_csv:
                for nm in sel_csv.split(","):
                    nm = nm.strip()
                    if not nm: continue
                    o = self.doc.getObject(nm)
                    if o:
                        it = QtWidgets.QListWidgetItem(o.Label)
                        it.setData(QtCore.Qt.UserRole, o.Name)
                        self.lst_selected.addItem(it)
            self.chk_gl.setChecked(p.GetBool("LightEnabled", False))
            self.spn_gl_int.setValue(p.GetFloat("LightIntensity", 1.2))
            col_s = p.GetString("LightColor", "255,255,255")
            try:
                r,g,b = [int(x) for x in col_s.split(",")]
            except:
                r,g,b = 255,255,255
            self._set_color(QtGui.QColor(r,g,b))
            self.spn_gl_yaw.setValue(p.GetFloat("LightYaw", 135.0))
            self.spn_gl_pitch.setValue(p.GetFloat("LightPitch", -35.0))
            self.ed_gs.setText(p.GetString("GameStartName", p.GetString("DefaultGameStartName","GameStart")))
            self.chk_triang.setChecked(p.GetBool("OptTriangulate", False))
            self.chk_freeze.setChecked(p.GetBool("OptFreeze", False))
            self.chk_baseline.setChecked(p.GetBool("OptBaseline", False))
            self.ed_cge.setText(p.GetString("CGE_Path",""))
            self.chk_run_cge.setChecked(p.GetBool("AutoLaunchCGE", False))
            self.ed_default_gs.setText(p.GetString("DefaultGameStartName","GameStart"))
            self.chk_confirm_over.setChecked(p.GetBool("ConfirmOverwrite", True))
            self.spn_lat.setValue(p.GetFloat("SolarLatitude", 9.9))

    def _save_session_config(self):
        p = get_param()
        p.SetString("RootObject", self.ed_root.text().strip())
        p.SetString("OutputFolder", self.ed_out_folder.text().strip())
        p.SetString("BaseFileName", self.ed_base.text().strip())
        exp_names = []
        for i in range(self.lst_selected.count()):
            exp_names.append(self.lst_selected.item(i).data(QtCore.Qt.UserRole))
        p.SetString("ExportList", ",".join(exp_names))
        p.SetBool("LightEnabled", self.chk_gl.isChecked())
        p.SetFloat("LightIntensity", float(self.spn_gl_int.value()))
        col = self._get_color()
        p.SetString("LightColor", f"{col.red()},{col.green()},{col.blue()}")
        p.SetFloat("LightYaw", float(self.spn_gl_yaw.value()))
        p.SetFloat("LightPitch", float(self.spn_gl_pitch.value()))
        p.SetString("GameStartName", self.ed_gs.text().strip() or "GameStart")
        p.SetBool("OptTriangulate", self.chk_triang.isChecked())
        p.SetBool("OptFreeze", self.chk_freeze.isChecked())
        p.SetBool("OptBaseline", self.chk_baseline.isChecked())
        p.SetString("CGE_Path", self.ed_cge.text().strip())
        p.SetBool("AutoLaunchCGE", self.chk_run_cge.isChecked())
        p.SetString("DefaultGameStartName", self.ed_default_gs.text().strip() or "GameStart")
        p.SetBool("ConfirmOverwrite", self.chk_confirm_over.isChecked())
        p.SetFloat("SolarLatitude", float(self.spn_lat.value()))

        project_name = os.path.splitext(os.path.basename(self.doc.FileName))[0] if self.doc.FileName else None
        if project_name:
            json_path = os.path.join(os.path.dirname(self.doc.FileName), f"{project_name}.gee.json")
        else:
            json_path = os.path.join(self.ed_out_folder.text().strip(), (self.ed_base.text().strip() or "Export") + ".gee.json")
        try:
            data = {
                "root": self.ed_root.text().strip(),
                "exportedObjects": exp_names,
                "outputFolder": self.ed_out_folder.text().strip(),
                "baseFilename": self.ed_base.text().strip(),
                "globalLight": {
                    "enabled": self.chk_gl.isChecked(),
                    "intensity": float(self.spn_gl_int.value()),
                    "color": [col.red(), col.green(), col.blue()],
                    "yaw": float(self.spn_gl_yaw.value()),
                    "pitch": float(self.spn_gl_pitch.value())
                },
                "gameStart": {
                    "name": self.ed_gs.text().strip() or "GameStart",
                    "present": (self.ed_gs.text().strip() or "GameStart") in self.doc.Objects
                },
                "options": {
                    "triangulate": self.chk_triang.isChecked(),
                    "freeze": self.chk_freeze.isChecked(),
                    "autoBaseline": self.chk_baseline.isChecked()
                },
                "CGE_path": self.ed_cge.text().strip(),
                "AutoLaunchCGE": self.chk_run_cge.isChecked(),
                "defaultGameStartName": self.ed_default_gs.text().strip() or "GameStart",
                "confirmOverwrite": self.chk_confirm_over.isChecked(),
                "solarLatitude": float(self.spn_lat.value())
            }
            with open(json_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
            log_info(f"Sidecar guardado: {json_path}")
        except Exception as ex:
            log_warn(f"No se pudo guardar sidecar: {ex}")

    # ----------------- Presets -----------------

    def _on_preset_save(self):
        path, _ = QtWidgets.QFileDialog.getSaveFileName(self, "Guardar preset", "", "JSON (*.json)")
        if not path: return
        try:
            data = {
                "triangulate": self.chk_triang.isChecked(),
                "freeze": self.chk_freeze.isChecked(),
                "autoBaseline": self.chk_baseline.isChecked(),
                "CGE_path": self.ed_cge.text().strip(),
                "AutoLaunchCGE": self.chk_run_cge.isChecked(),
                "defaultGameStartName": self.ed_default_gs.text().strip() or "GameStart",
                "confirmOverwrite": self.chk_confirm_over.isChecked(),
                "solarLatitude": float(self.spn_lat.value())
            }
            with open(path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
            log_info(f"Preset guardado: {path}")
        except Exception as ex:
            QtWidgets.QMessageBox.critical(self, "Preset", f"No se pudo guardar preset:\n{ex}")

    def _on_preset_load(self):
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Cargar preset", "", "JSON (*.json)")
        if not path: return
        try:
            with open(path, "r", encoding="utf-8") as f:
                d = json.load(f)
            self.chk_triang.setChecked(bool(d.get("triangulate", False)))
            self.chk_freeze.setChecked(bool(d.get("freeze", False)))
            self.chk_baseline.setChecked(bool(d.get("autoBaseline", False)))
            self.ed_cge.setText(d.get("CGE_path", ""))
            self.chk_run_cge.setChecked(bool(d.get("AutoLaunchCGE", False)))
            self.ed_default_gs.setText(d.get("defaultGameStartName", "GameStart"))
            self.chk_confirm_over.setChecked(bool(d.get("confirmOverwrite", True)))
            self.spn_lat.setValue(float(d.get("solarLatitude", 9.9)))
            log_info("Preset cargado.")
        except Exception as ex:
            QtWidgets.QMessageBox.critical(self, "Preset", f"No se pudo cargar preset:\n{ex}")

    def _on_restore_defaults(self):
        self.chk_triang.setChecked(False)
        self.chk_freeze.setChecked(False)
        self.chk_baseline.setChecked(False)
        self.chk_confirm_over.setChecked(True)
        self.ed_cge.setText("")
        self.chk_run_cge.setChecked(False)
        self.ed_default_gs.setText("GameStart")
        self.spn_lat.setValue(9.9)

    def _set_status(self, msg):
        self.status.setText(msg)
        log_info(msg)

# ----------------- RUN -----------------

def run():
    try:
        dlg = GameEngineExportDialog(Gui.getMainWindow())
        dlg.exec_()
    except Exception as ex:
        import traceback
        log_err("Dialog crashed:\n" + traceback.format_exc())

if __name__ == "__main__":
    App.Console.PrintMessage("[GAMEEXPORT][DEBUG] macro build: gui-redesign-v2.3\n")
    App.Console.PrintMessage("[GAMEEXPORT][INFO] Starting GameEngineExport...\n")
    run()
# -*- coding: utf-8 -*-