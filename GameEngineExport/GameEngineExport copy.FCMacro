class GameEngineExportDialog(QtWidgets.QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("GameEngineExport - FreeCAD to Castle Game Engine (X3D)")
        self.resize(940, 620)

        self.doc = get_active_doc()
        self.root_obj = None

        # widgets
        self.tabs = QtWidgets.QTabWidget()

        self.tab_project = self._build_tab_project()
        self.tab_scene = self._build_tab_scene()
        self.tab_lights = self._build_tab_lights()
        self.tab_materials = self._build_tab_materials()
        self.tab_start = self._build_tab_start()
        self.tab_presets = self._build_tab_presets()
        self.tab_settings = self._build_tab_settings()

        self.tabs.addTab(self.tab_project, "Project / Proyecto")
        self.tabs.addTab(self.tab_scene, "Scene / Escena")
        self.tabs.addTab(self.tab_lights, "Lights / Luces")
        self.tabs.addTab(self.tab_materials, "Materials / Materiales")
        self.tabs.addTab(self.tab_start, "Start / Inicio")
        self.tabs.addTab(self.tab_presets, "Presets / Perfiles")
        self.tabs.addTab(self.tab_settings, "Settings / Config")

        # status bar like label
        self.status = QtWidgets.QLabel("Ready.")

        # layout
        main = QtWidgets.QVBoxLayout(self)
        main.addWidget(self.tabs)
        main.addWidget(self.status)

        # restore parameters
        self._restore_params()

        # auto baseline export on open
        if self.chk_auto_baseline.isChecked():
            self._do_baseline_export()

