        lay.addRow("", self.chk_auto_launch_cge)
        return w

    # ---------- helpers ----------
    def _h(self, *widgets):
        w = QtWidgets.QWidget()
        h = QtWidgets.QHBoxLayout(w)
        h.setContentsMargins(0,0,0,0)
        for ww in widgets:
            h.addWidget(ww)
        h.addStretch(1)
        return w

    def _conf_float(self, spn, a, b, val):
        spn.setRange(a,b)
        spn.setDecimals(3)
        spn.setSingleStep(0.05)
        spn.setValue(val)

    # ---------- param restore/save ----------
    def _restore_params(self):
        doc_dir, stem = get_doc_dir_and_stem()
        if doc_dir:
            self.ed_export_dir.setText(str(doc_dir))
        else:
            saved_dir = get_param_str("export_dir", DEFAULT_EXPORT_DIR).strip()
            self.ed_export_dir.setText(saved_dir or DEFAULT_EXPORT_DIR)

        if doc_dir:
            saved_base = get_param_str("base_name", "").strip()
            self.ed_base_name.setText(saved_base or stem)
        else:
            self.ed_base_name.setText(get_param_str("base_name", "Scene"))
        self.ed_root.setText(get_param_str("root_label", ""))

        self.chk_auto_baseline.setChecked(get_param_bool("auto_baseline", False))

        self.chk_walls.setChecked(get_param_bool("cat_walls", True))
        self.chk_floors.setChecked(get_param_bool("cat_floors", True))
        self.chk_roofs.setChecked(get_param_bool("cat_roofs", True))
        self.chk_furniture.setChecked(get_param_bool("cat_furniture", True))
        self.chk_lights.setChecked(get_param_bool("cat_lights", True))
        self.chk_cameras.setChecked(get_param_bool("cat_cameras", False))

        self.chk_triangulate.setChecked(get_param_bool("triangulate", True))
        self.chk_freeze_colors.setChecked(get_param_bool("freeze_colors", True))

        # material defaults
        self.spn_em_r.setValue(float(get_param_str("em_r","0.0")))
        self.spn_em_g.setValue(float(get_param_str("em_g","0.0")))
        self.spn_em_b.setValue(float(get_param_str("em_b","0.0")))
        self.spn_transp.setValue(float(get_param_str("m_transp","0.0")))
        self.spn_shiny.setValue(float(get_param_str("m_shiny","0.2")))

        self.ed_default_dir.setText(get_param_str("export_dir_default", DEFAULT_EXPORT_DIR))
        self.ed_suffix.setText(get_param_str("file_suffix", ""))
        self.chk_restore.setChecked(get_param_bool("restore_last", True))
        self.ed_cge_path.setText(get_param_str("cge_executable_path", ""))
        self.chk_auto_launch_cge.setChecked(get_param_bool("auto_launch_cge", False))
        if hasattr(self, "ed_gamestart"):
            self.ed_gamestart.setText(get_param_str("gamestart_label", "GameStart"))
        self._refresh_object_lists(silent=True)

    def _save_params(self):
        set_param_str("export_dir", self.ed_export_dir.text().strip())
        set_param_str("base_name", self.ed_base_name.text().strip())
        set_param_str("root_label", self.ed_root.text().strip())

        set_param_bool("auto_baseline", self.chk_auto_baseline.isChecked())

        set_param_bool("cat_walls", self.chk_walls.isChecked())
        set_param_bool("cat_floors", self.chk_floors.isChecked())
        set_param_bool("cat_roofs", self.chk_roofs.isChecked())
        set_param_bool("cat_furniture", self.chk_furniture.isChecked())
        set_param_bool("cat_lights", self.chk_lights.isChecked())
        set_param_bool("cat_cameras", self.chk_cameras.isChecked())

        set_param_bool("triangulate", self.chk_triangulate.isChecked())
        set_param_bool("freeze_colors", self.chk_freeze_colors.isChecked())

        set_param_str("em_r", str(self.spn_em_r.value()))
        set_param_str("em_g", str(self.spn_em_g.value()))
        set_param_str("em_b", str(self.spn_em_b.value()))
        set_param_str("m_transp", str(self.spn_transp.value()))
        set_param_str("m_shiny", str(self.spn_shiny.value()))

        set_param_str("export_dir_default", self.ed_default_dir.text().strip())
        set_param_str("file_suffix", self.ed_suffix.text().strip())
        set_param_bool("restore_last", self.chk_restore.isChecked())
        if hasattr(self, "ed_gamestart"):
            set_param_str("gamestart_label", self.ed_gamestart.text().strip())

        cge_path = self.ed_cge_path.text().strip()
        if cge_path:
            if is_valid_cge_executable(cge_path):
                set_param_str("cge_executable_path", cge_path)
            else:
                self._set_status("Castle Game Engine ejecutable no encontrado.")
                log_warn("No se encontro la ruta de CGE.")
        else:
            set_param_str("cge_executable_path", "")
        set_param_bool("auto_launch_cge", self.chk_auto_launch_cge.isChecked())


    # ---------- preset helpers ----------
    def _collect_preset_data(self):
        """Collect current UI state into a dict to be saved as a preset."""
        data = {
            "root_label": self.ed_root.text().strip(),
            "export_dir": self.ed_export_dir.text().strip(),
            "base_name": self.ed_base_name.text().strip(),
            "auto_baseline": self.chk_auto_baseline.isChecked(),
            "gamestart_label": self.ed_gamestart.text().strip() if hasattr(self, "ed_gamestart") else "GameStart",
            "selected_objects": sorted(self._selected_object_names),

            "cats": {
                "Walls": self.chk_walls.isChecked(),
                "Floors": self.chk_floors.isChecked(),
                "Roofs": self.chk_roofs.isChecked(),
                "Furniture": self.chk_furniture.isChecked(),
                "Lights": self.chk_lights.isChecked(),
                "Cameras": self.chk_cameras.isChecked(),
            },

            "triangulate": self.chk_triangulate.isChecked(),
            "freeze_colors": self.chk_freeze_colors.isChecked(),

            "materials": {
                "em_r": float(self.spn_em_r.value()),
                "em_g": float(self.spn_em_g.value()),
                "em_b": float(self.spn_em_b.value()),
                "transp": float(self.spn_transp.value()),
                "shiny": float(self.spn_shiny.value()),
            },

            "settings": {
                "default_dir": self.ed_default_dir.text().strip(),
                "file_suffix": self.ed_suffix.text().strip(),
                "restore_last": self.chk_restore.isChecked(),
              "cge_executable_path": self.ed_cge_path.text().strip(),
              "auto_launch_cge": self.chk_auto_launch_cge.isChecked(),
          }
      }
        data["lights"] = copy.deepcopy(self._light_entries)
        return data

    def _apply_preset_data(self, data: dict):
        """Apply a loaded preset dict to the UI and params (does not run exports)."""
        # project
        self.ed_root.setText(data.get("root_label",""))
        self.ed_export_dir.setText(data.get("export_dir", self.ed_export_dir.text()))
        self.ed_base_name.setText(data.get("base_name", self.ed_base_name.text()))
        self.chk_auto_baseline.setChecked(bool(data.get("auto_baseline", False)))
        if hasattr(self, "ed_gamestart"):
            self.ed_gamestart.setText(data.get("gamestart_label", self.ed_gamestart.text()))
        self._selected_object_names = set(data.get("selected_objects", []))
        self._refresh_object_lists(silent=True)
        self._light_entries = copy.deepcopy(data.get("lights", []))
        self._refresh_light_summary(silent=True)

        # categories
        cats = data.get("cats", {})
        self.chk_walls.setChecked(bool(cats.get("Walls", self.chk_walls.isChecked())))
        self.chk_floors.setChecked(bool(cats.get("Floors", self.chk_floors.isChecked())))
        self.chk_roofs.setChecked(bool(cats.get("Roofs", self.chk_roofs.isChecked())))
        self.chk_furniture.setChecked(bool(cats.get("Furniture", self.chk_furniture.isChecked())))
        self.chk_lights.setChecked(bool(cats.get("Lights", self.chk_lights.isChecked())))
        self.chk_cameras.setChecked(bool(cats.get("Cameras", self.chk_cameras.isChecked())))

        # scene options
        self.chk_triangulate.setChecked(bool(data.get("triangulate", self.chk_triangulate.isChecked())))
        self.chk_freeze_colors.setChecked(bool(data.get("freeze_colors", self.chk_freeze_colors.isChecked())))

        # materials
        mats = data.get("materials", {})
        self.spn_em_r.setValue(float(mats.get("em_r", self.spn_em_r.value())))
        self.spn_em_g.setValue(float(mats.get("em_g", self.spn_em_g.value())))
        self.spn_em_b.setValue(float(mats.get("em_b", self.spn_em_b.value())))
        self.spn_transp.setValue(float(mats.get("transp", self.spn_transp.value())))
        self.spn_shiny.setValue(float(mats.get("shiny", self.spn_shiny.value())))

        # settings
        st = data.get("settings", {})
        self.ed_default_dir.setText(st.get("default_dir", self.ed_default_dir.text()))
        self.ed_suffix.setText(st.get("file_suffix", self.ed_suffix.text()))
        self.chk_restore.setChecked(bool(st.get("restore_last", self.chk_restore.isChecked())))
        self.ed_cge_path.setText(st.get("cge_executable_path", self.ed_cge_path.text()))
        self.chk_auto_launch_cge.setChecked(bool(st.get("auto_launch_cge", self.chk_auto_launch_cge.isChecked())))

        # persist to ParamGet tambien, para mantener coherencia
        self._save_params()

    # ---------- presets actions ----------
    def _do_save_preset(self):
        """Save current UI state as a JSON preset."""
        try:
            name = self.ed_preset_name.text().strip() or "default"
            data = self._collect_preset_data()
            save_preset(name, data)
            self._set_status(f"Preset saved / Perfil guardado: {name}")
        except Exception as ex:
            self._set_status(f"Save preset failed: {ex}")
            log_err(ex)

    def _do_load_preset(self):
        """Load a JSON preset and apply it to the UI."""
        try:
            name = self.ed_preset_name.text().strip() or "default"
            data = load_preset(name)
            self._apply_preset_data(data)
            self._set_status(f"Preset loaded / Perfil cargado: {name}")
        except Exception as ex:
            self._set_status(f"Load preset failed: {ex}")
            log_err(ex)

    def accept(self):
        self._save_params()
        super().accept()

    # ---------- actions ----------
    def _pick_selected_root(self):
        sel = Gui.Selection.getSelection()
        if not sel:
            self._set_status("No selection. / Sin seleccion.")
            return
        self.root_obj = sel[0]
        self.ed_root.setText(self.root_obj.Label)
        self._selected_object_names.clear()
        self._refresh_object_lists(silent=True)
        self._set_status(f"Root set to: {self.root_obj.Label}")

    def _browse_dir(self):
        d = QtWidgets.QFileDialog.getExistingDirectory(self, "Select export folder")
        if d:
            self.ed_export_dir.setText(d)

    def _browse_cge_executable(self):
        path, _ = QtWidgets.QFileDialog.getOpenFileName(
            self,
            "Select Castle Game Engine executable",
            self.ed_cge_path.text().strip() or "",
        )
        if path:
            self.ed_cge_path.setText(path)

    def _resolve_root(self):
        label = self.ed_root.text().strip()
        if not label:
            raise RuntimeError("Root label empty / Raiz vacia")
        obj = find_object_by_label(self.doc, label)
        if obj is None:
            raise RuntimeError("Root not found / Raiz no encontrada")
        return obj

    def _maybe_launch_cge(self, exported_file):
        if not self.chk_auto_launch_cge.isChecked():
            return

        cge_path = self.ed_cge_path.text().strip()
        if not is_valid_cge_executable(cge_path):
            self._set_status("Castle Game Engine no encontrado. Configure la ruta en configuracion.")
            log_warn("No se encontro la ruta de CGE.")
            return

        exported = Path(exported_file)
        if not exported.exists():
            self._set_status("Archivo exportado no encontrado para lanzar CGE.")
            log_warn("Archivo exportado no encontrado para lanzar CGE.")
            return

        self._set_status("Ejecutando Castle Game Engine...")
        if launch_cge(cge_path, str(exported)):
            self._set_status("Exportacion completada y lanzada en CGE.")
        else:
            self._set_status("Castle Game Engine ejecutable no encontrado.")

    def _do_baseline_export(self):
        try:
            categories = self._gather_category_selection()
            export_objs = self._prepare_export_objects(categories)
            out_dir = self.ed_export_dir.text().strip() or get_project_export_dir_fallback()
            ensure_dir(out_dir)
            base_name = self.ed_base_name.text().strip() or "Scene"
            # suffix
            suffix = get_param_str("file_suffix","")
            if suffix:
                base_name = f"{base_name}{suffix}"

            path = make_baseline_export(export_objs, out_dir, base_name)
            self._postprocess_export(path)
            self._set_status(f"Baseline exported: {path}")
            set_param_str("last_export_path", path)
            data = self._collect_preset_data()
            save_project_sidecar(data)
            self._maybe_launch_cge(path)
        except Exception as ex:
            self._set_status(f"Baseline export failed: {ex}")
            log_err(ex)

    def _do_scene_export(self):
        try:
            categories = self._gather_category_selection()
            export_objs = self._prepare_export_objects(categories)
            if not any(c in categories for c in ["Floors"]):
                log_warn("No floor selected; player navigation may fail / Sin piso la navegacion puede fallar")

            out_dir = self.ed_export_dir.text().strip() or get_project_export_dir_fallback()
            ensure_dir(out_dir)
            base_name = self.ed_base_name.text().strip() or "Scene"

            # time suffix option
            suffix = get_param_str("file_suffix","")
            if suffix:
                base_name = f"{base_name}{suffix}"

            out_file = str(Path(out_dir).joinpath(f"{base_name}.x3d"))
            export_objects_to_x3d(export_objs, out_file)
            self._postprocess_export(out_file)
            self._set_status(f"Scene exported: {out_file}")
            set_param_str("last_export_path", out_file)
            data = self._collect_preset_data()
            save_project_sidecar(data)
            self._maybe_launch_cge(out_file)
        except Exception as ex:
            self._set_status(f"Scene export failed: {ex}")
            log_err(ex)

    def _postprocess_export(self, filepath):
        gamestart = ""
        if hasattr(self, "ed_gamestart"):
            gamestart = self.ed_gamestart.text().strip()
        try:
            decorate_x3d_scene(filepath, self.doc, gamestart or "GameStart", copy.deepcopy(self._light_entries))
        except Exception as ex:
            log_warn(f"Postproceso X3D fallo: {ex}")

    def _do_detect_lights(self):
        try:
            root = self._resolve_root()
            lights = detect_lights(root)
            self.lst_lights.clear()
            for o in lights:
                self.lst_lights.addItem(o.Label)
            self._set_status(f"Detected lights: {len(lights)}")
        except Exception as ex:
            self._set_status(f"Detect lights failed: {ex}")
            log_err(ex)

    def _do_normalize_selection(self):
        items = self.lst_lights.selectedItems()
        if not items:
            self._set_status("No light selected / Sin seleccion")
            return
        try:
            root = self._resolve_root()
            names = [it.text() for it in items]
            objs = [o for o in collect_children_recursive(root) if o.Label in names]
            normalize_lights(objs)
            self._set_status("Selected lights normalized / Seleccion normalizada")
        except Exception as ex:
            self._set_status(f"Normalize selection failed: {ex}")
            log_err(ex)

    def _do_normalize_all(self):
        try:
            root = self._resolve_root()
            objs = detect_lights(root)
            normalize_lights(objs)
            self._set_status("All lights normalized / Todas normalizadas")
        except Exception as ex:
            self._set_status(f"Normalize all failed: {ex}")
            log_err(ex)

    def _do_apply_emissive_sel(self):
        try:
            sel = Gui.Selection.getSelection()
            if not sel:
                self._set_status("No selection / Sin seleccion")
                return
            rgb = (self.spn_em_r.value(), self.spn_em_g.value(), self.spn_em_b.value())
            apply_emissive_to_objects(sel, rgb, self.spn_transp.value(), self.spn_shiny.value())
            self._set_status("Applied to selection / Aplicado a seleccion")
        except Exception as ex:
            self._set_status(f"Apply to selection failed: {ex}")
            log_err(ex)

    def _do_apply_emissive_all(self):
        try:
            root = self._resolve_root()
            all_objs = collect_children_recursive(root)
            rgb = (self.spn_em_r.value(), self.spn_em_g.value(), self.spn_em_b.value())
            apply_emissive_to_objects(all_objs, rgb, self.spn_transp.value(), self.spn_shiny.value())
            self._set_status("Applied to all / Aplicado a todos")
        except Exception as ex:
            self._set_status(f"Apply to all failed: {ex}")
            log_err(ex)

    def _do_create_gamestart(self):
        try:
            name = self.ed_gamestart.text().strip() or "GameStart"
            obj = create_gamestart(self.doc, name)
            self._set_status(f"GameStart ready: {obj.Label}")
        except Exception as ex:
            self._set_status(f"Create GameStart failed: {ex}")
            log_err(ex)

    def _set_status(self, msg):
        self.status.setText(msg)
        log_info(msg)


# -------------------------------
# Run dialog
# -------------------------------

def run():
    try:
        dlg = GameEngineExportDialog(Gui.getMainWindow())
        dlg.exec_()
    except Exception as ex:
        log_err(f"Dialog failed: {ex}")

if __name__ == "__main__":
    log_info("Starting GameEngineExport...")
    run()







































