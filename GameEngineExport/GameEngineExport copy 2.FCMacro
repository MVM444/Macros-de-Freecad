PARAM_ROOT = "User parameter:BaseApp/Preferences/GameEngineExport"
if App is not None:
    _USER_APP_DIR = Path(App.getUserAppDataDir())
else:
    _USER_APP_DIR = Path.home()
DEFAULT_EXPORT_DIR = str(_USER_APP_DIR.joinpath("tmp"))
PRESETS_DIR_NAME = "presets"
APP_PREFIX = "[GAMEEXPORT]"

SCALE_TO_METERS = 0.001  # FreeCAD mm -> meters for X3D engines

# -------------------------------
# Utilities and logging
# -------------------------------

def log_info(msg):
    App.Console.PrintMessage(f"{APP_PREFIX}[INFO] {msg}\n")

def log_warn(msg):
    App.Console.PrintWarning(f"{APP_PREFIX}[WARN] {msg}\n")

def log_err(msg):
    App.Console.PrintError(f"{APP_PREFIX}[ERROR] {msg}\n")

def log_dbg(msg):
    # promote or demote as needed
    App.Console.PrintMessage(f"{APP_PREFIX}[DEBUG] {msg}\n")

def param_get(group=PARAM_ROOT):
    return App.ParamGet(group)

def get_param_str(key, default=""):
    return param_get().GetString(key, default)

def set_param_str(key, val):
    param_get().SetString(key, val)

def get_param_bool(key, default=False):
    return param_get().GetBool(key, default)

def set_param_bool(key, val):
    param_get().SetBool(key, val)

def ensure_dir(p):
    Path(p).mkdir(parents=True, exist_ok=True)


def get_doc_dir_and_stem():
    """Return (doc_dir: Path or None, stem_sanitized: str) from the active document."""
    doc = get_active_doc()
    fname = getattr(doc, "FileName", "") or ""
    if fname:
        p = Path(fname)
        doc_dir = p.parent
        stem = p.stem
    else:
        doc_dir = None
        stem = getattr(doc, "Label", "Scene")

    normalized = unicodedata.normalize("NFKD", stem)
    stem_ascii = "".join(
        ch for ch in normalized if ((ch.isalnum() and ord(ch) < 128) or ch == "_")
    )
    if not stem_ascii:
        stem_ascii = "Scene"
    return doc_dir, stem_ascii


def get_project_export_dir_fallback():
    """Prefer the document directory; fallback to DEFAULT_EXPORT_DIR."""
    doc_dir, _ = get_doc_dir_and_stem()
    if doc_dir:
        return str(doc_dir)
    configured = get_param_str("export_dir", DEFAULT_EXPORT_DIR).strip()
    return configured or DEFAULT_EXPORT_DIR


def get_sidecar_path():
    """Return Path for per-file config JSON in the same dir as the FCStd."""
    doc_dir, stem = get_doc_dir_and_stem()
    if not doc_dir:
        fallback_dir = get_param_str("export_dir", DEFAULT_EXPORT_DIR).strip() or DEFAULT_EXPORT_DIR
        return Path(fallback_dir).joinpath(f"{stem}.gee.json")
    return doc_dir.joinpath(f"{stem}.gee.json")


def save_project_sidecar(data: dict):
    p = get_sidecar_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    log_info(f"Project sidecar saved: {p}")


def load_project_sidecar():
    p = get_sidecar_path()
    if p.exists():
        with open(p, "r", encoding="utf-8") as f:
            return json.load(f)
    return None


def _fmt(val, digits=6):
    text = f"{val:.{digits}f}"
    if "." in text:
        text = text.rstrip("0").rstrip(".")
    return text or "0"


def _rotation_from_euler(yaw_deg=0.0, pitch_deg=0.0, roll_deg=0.0):
    """Return FreeCAD Rotation composed from yaw(Z), pitch(Y), roll(X)."""
    rot_z = App.Rotation(App.Vector(0, 0, 1), float(yaw_deg))
    rot_y = App.Rotation(App.Vector(0, 1, 0), float(pitch_deg))
    rot_x = App.Rotation(App.Vector(1, 0, 0), float(roll_deg))
    return rot_z.multiply(rot_y).multiply(rot_x)


def compute_gamestart_viewpoint(doc, name):
    """Return dict with position (mm), orientation (axis-angle rad) and fov from GameStart marker."""
    if App is None or doc is None or not name:
        return None
    obj = doc.getObject(name)
    if obj is None:
        obj = find_object_by_label(doc, name)
    if obj is None:
        return None

    base = getattr(obj.Placement, "Base", App.Vector(0, 0, 0))
    height_offset_m = float(getattr(obj, "HeightOffset", 1.6))
    height_offset_mm = height_offset_m * 1000.0
    position_mm = App.Vector(base.x, base.y, base.z + height_offset_mm)

    yaw = float(getattr(obj, "Yaw", 0.0))
    pitch = float(getattr(obj, "Pitch", 0.0))
    roll = float(getattr(obj, "Roll", 0.0))
    user_rot = _rotation_from_euler(yaw, pitch, roll)
    placement_rot = getattr(obj.Placement, "Rotation", App.Rotation())
    final_rot = placement_rot.multiply(user_rot)

    axis = App.Vector(final_rot.Axis.x, final_rot.Axis.y, final_rot.Axis.z)
    angle_deg = float(final_rot.Angle)
    if axis.Length == 0 or abs(angle_deg) < 1e-6:
        axis = App.Vector(0, 1, 0)
        angle_rad = 0.0
    else:
        axis.normalize()
        angle_rad = math.radians(angle_deg)

    fov_deg = float(getattr(obj, "FOV", 60.0))
    fov_rad = math.radians(fov_deg)
    desc = getattr(obj, "Label", name) or name
    desc = desc.replace('"', "'")

    return {
        "position_mm": (position_mm.x, position_mm.y, position_mm.z),
        "orientation": (axis.x, axis.y, axis.z, angle_rad),
        "field_of_view": fov_rad,
        "description": desc,
    }


def convert_viewpoint_to_scene(data, rotation=None, scale=1.0):
    """Apply rotation/scale to viewpoint data to match scene coordinates."""
    if App is None:
        axis = data["orientation"][:3]
        angle = data["orientation"][3]
        position = tuple(v * scale for v in data["position_mm"])
        return {
            "position": position,
            "orientation": (*axis, angle),
            "field_of_view": data["field_of_view"],
            "description": data["description"],
        }

    rot = rotation or App.Rotation()
    pos_vec = App.Vector(*data["position_mm"])
    pos_rot = rot.multVec(pos_vec)
    pos_scaled = (pos_rot.x * scale, pos_rot.y * scale, pos_rot.z * scale)

    axis_vec = App.Vector(*data["orientation"][:3])
    if axis_vec.Length == 0:
        view_rot = App.Rotation()
    else:
        view_rot = App.Rotation(axis_vec, math.degrees(data["orientation"][3]))
    final_rot = rot.multiply(view_rot)
    final_axis = final_rot.Axis
    if final_axis.Length == 0:
        final_axis = App.Vector(0, 1, 0)
    orientation = (
        final_axis.x,
        final_axis.y,
        final_axis.z,
        math.radians(final_rot.Angle),
    )
    return {
        "position": pos_scaled,
        "orientation": orientation,
        "field_of_view": data["field_of_view"],
        "description": data["description"],
    }


def _get_object_center(obj):
    shape = getattr(obj, "Shape", None)
    if shape and hasattr(shape, "BoundBox") and not shape.isNull():
        try:
            bb = shape.BoundBox
            return App.Vector(bb.Center.x, bb.Center.y, bb.Center.z)
        except Exception:
            pass
    base = getattr(getattr(obj, "Placement", None), "Base", None)
    if base is not None:
        return App.Vector(base.x, base.y, base.z)
    return App.Vector(0, 0, 0)


def _find_down_face(obj):
    shape = getattr(obj, "Shape", None)
    if not shape or shape.isNull():
        return None, None
    best_area = 0.0
    best_center = None
    best_normal = None
    try:
        for face in shape.Faces:
            normal = face.normalAt(0.5, 0.5)
            if normal.z < -0.7 and face.Area > best_area:
                best_area = face.Area
                best_center = face.CenterOfMass
                best_normal = normal
    except Exception:
        return None, None
    if best_center is None or best_normal is None:
        return None, None
    return (
        App.Vector(best_center.x, best_center.y, best_center.z),
        App.Vector(best_normal.x, best_normal.y, best_normal.z),
    )


def _sanitize_id(text):
    token = _normalize_token(text)
    token = re.sub(r"[^a-z0-9_]+", "_", token)
    token = token.strip("_")
    return token or "light"


def build_light_nodes(doc, entries):
    if not entries:
        return []
    nodes = []
    for entry in entries:
        name = entry.get("name")
        if not name:
            continue
        obj = doc.getObject(name)
        if obj is None:
            log_warn(f"Luz omitida, objeto no encontrado: {name}")
            continue
        label = getattr(obj, "Label", name)
        light_type = entry.get("type", "PointLight")
        intensity = max(0.0, min(1.0, float(entry.get("intensity", 1.0))))
        radius_m = max(0.0, float(entry.get("radius_m", 5.0)))
        radius_mm = radius_m * 1000.0
        safe = _sanitize_id(label)

        if light_type == "SpotLight":
            center, normal = _find_down_face(obj)
            if center is None or normal is None:
                log_warn(f"SpotLight sin cara inferior valida: {label}")
                continue
            location = " ".join(_fmt(v) for v in (center.x, center.y, center.z))
            try:
                normal.normalize()
            except Exception:
                pass
            direction = " ".join(_fmt(v) for v in (normal.x, normal.y, normal.z))
            beam = _fmt(float(entry.get("beam_width", 0.7)))
            cutoff = _fmt(float(entry.get("cut_off", 1.0)))
            radius = _fmt(radius_mm)
            node = (
                f'<SpotLight DEF="Spot_{safe}" location="{location}" direction="{direction}" '
                f'color="1 1 1" intensity="{_fmt(intensity)}" beamWidth="{beam}" cutOffAngle="{cutoff}" '
                f'radius="{radius}"/>'
            )
            nodes.append(node)
        elif light_type == "DirectionalLight":
            _, normal = _find_down_face(obj)
            if normal is None:
                normal = App.Vector(0, -1, -1)
            try:
                normal.normalize()
            except Exception:
                pass
            direction = " ".join(_fmt(v) for v in (normal.x, normal.y, normal.z))
            node = (
                f'<DirectionalLight DEF="Dir_{safe}" direction="{direction}" '
                f'color="1 1 1" intensity="{_fmt(intensity)}"/>'
            )
            nodes.append(node)
        else:
            center = _get_object_center(obj)
            location = " ".join(_fmt(v) for v in (center.x, center.y, center.z))
            radius = _fmt(radius_mm)
            node = (
                f'<PointLight DEF="Point_{safe}" location="{location}" color="1 1 1" '
                f'intensity="{_fmt(intensity)}" radius="{radius}"/>'
            )
            nodes.append(node)
    return nodes


def build_viewpoint_xml(data, include_def=True):
    pos = " ".join(_fmt(v) for v in data["position"])
    orient = " ".join(_fmt(v) for v in data["orientation"])
    fov = _fmt(data["field_of_view"])
    desc = data["description"]
    def_attr = ' DEF="GameStartView"' if include_def else ""
    return (
        f'<Viewpoint{def_attr} description="{desc}" position="{pos}" '
        f'orientation="{orient}" fieldOfView="{fov}" centerOfRotation="{pos}"/>'
    )


def _remove_tag(body, tag):
    pattern_pair = rf'\s*<{tag}\b[^>]*?>[\s\S]*?</{tag}>\s*'
    pattern_self = rf'\s*<{tag}\b[^>]*?\/>\s*'
    body = re.sub(pattern_pair, "\n", body, flags=re.IGNORECASE)
    body = re.sub(pattern_self, "\n", body, flags=re.IGNORECASE)
    return body


def _purge_scene_overrides(body):
    body = re.sub(r'\s*<!--\s*\[CastleProject\][\s\S]*?-->\s*', "\n", body, flags=re.IGNORECASE)
    for tag in ("NavigationInfo", "Background", "Viewpoint"):
        body = _remove_tag(body, tag)
    return body.strip()


def decorate_x3d_scene(filepath, doc, gamestart_name, light_entries=None):
    """Rewrite exported X3D to match Castle Game Engine expectations."""
    try:
        text = Path(filepath).read_text(encoding="utf-8")
    except Exception as ex:
        log_warn(f"No se pudo leer X3D para postprocesar: {ex}")
        return

    scene_start = text.find("<Scene")
    if scene_start == -1:
        log_warn("X3D export no contiene <Scene>; se omite postproceso.")
        return
    scene_open_end = text.find(">", scene_start)
    scene_close = text.rfind("</Scene>")
    if scene_open_end == -1 or scene_close == -1:
        log_warn("X3D Scene incompleta; se omite postproceso.")
        return

    prefix = text[:scene_start]
    scene_open_tag = text[scene_start:scene_open_end + 1]
    body = text[scene_open_end + 1:scene_close]
    suffix = text[scene_close:]

    xml_decl = ""
    if prefix.startswith("<?xml"):
        xml_end = prefix.find("?>") + 2
        xml_decl = prefix[:xml_end]
        prefix = prefix[xml_end:]

    body = _purge_scene_overrides(body)
    transform_rotation = App.Rotation(App.Vector(1, 0, 0), -90.0) if App is not None else None

    viewpoint_data = compute_gamestart_viewpoint(doc, gamestart_name)
    scale_factor = SCALE_TO_METERS
    if viewpoint_data is None:
        log_warn("GameStart no encontrado; se usa viewpoint por defecto.")
        default_data = {
            "position_mm": (0.0, 0.0, 1600.0),
            "orientation": (0.0, 1.0, 0.0, 0.0),
            "field_of_view": math.radians(60.0),
            "description": "Default start",
        }
        viewpoint_scene = convert_viewpoint_to_scene(default_data, transform_rotation, scale_factor)
    else:
        viewpoint_scene = convert_viewpoint_to_scene(viewpoint_data, transform_rotation, scale_factor)
    viewpoint_xml = build_viewpoint_xml(viewpoint_scene)

    geometry = body.strip()
    scale_str = _fmt(scale_factor)
    transform_lines = [
        f'  <Transform DEF="FCScene" rotation="1 0 0 -1.57079632679" scale="{scale_str} {scale_str} {scale_str}">'
    ]
    if geometry:
        transform_lines.append(textwrap.indent(geometry, "    "))
    else:
        transform_lines.append("    <!-- (Scene vacia) -->")
    light_nodes = build_light_nodes(doc, light_entries or [])
    for node in light_nodes:
        transform_lines.append(textwrap.indent(node, "    "))
    transform_lines.append("  </Transform>")
    transform_block = "\n".join(transform_lines)

    background = '  <Background skyColor="0.2 0.4 1.0" groundColor="0.4 0.2 0.1"/>'
    navigation = '  <NavigationInfo avatarSize="0.25 1.6 0.75" speed="2" headlight="false" type=\'"WALK" "ANY"\'/>'

    new_body_parts = [background, navigation, viewpoint_xml, transform_block]
    new_body = "\n".join(new_body_parts) + "\n"

    castle_comment = "<!-- [CastleProject] DefaultLights=false WalkNavigation=true -->\n"
    if "[CastleProject]" in prefix:
        castle_comment = ""

    new_text = xml_decl + castle_comment + prefix + scene_open_tag + "\n" + new_body + suffix

    try:
        Path(filepath).write_text(new_text, encoding="utf-8")
        log_info(f"X3D postprocesado: {filepath}")
    except Exception as ex:
        log_warn(f"No se pudo escribir X3D postprocesado: {ex}")


def _normalize_token(text):
    if not text:
        return ""
    normalized = unicodedata.normalize("NFKD", str(text))
    ascii_text = "".join(ch for ch in normalized if ord(ch) < 128)
    return ascii_text.lower()


CATEGORY_KEYWORDS = {
    "Lights": {"light", "lights", "luz", "luces", "lamp", "lampara", "spot", "foco"},
    "Cameras": {"camera", "camara", "view", "vista"},
    "Walls": {"wall", "walls", "muro", "muros", "pared", "paredes", "partition"},
    "Floors": {"floor", "floors", "piso", "pisos", "slab", "slabs", "losa", "losas", "forjado", "suelo"},
    "Roofs": {"roof", "roofs", "techo", "techos", "cubierta", "azotea"},
    "Furniture": {"furniture", "mueble", "muebles", "sofa", "silla", "mesa", "cama", "escritorio", "puerta", "door", "ventana", "window", "stair", "escalera"},
}

CATEGORY_TYPE_HINTS = {
    "Lights": {"light", "lamp"},
    "Cameras": {"camera"},
    "Walls": {"wall"},
    "Floors": {"floor", "slab"},
    "Roofs": {"roof"},
    "Furniture": {"furn", "door", "window", "stair"},
}


def _collect_tokens_for_object(obj):
    tokens = []
    for attr in ("Label", "Name", "TypeId", "IfcType"):
        tokens.append(_normalize_token(getattr(obj, attr, "")))
    proxy = getattr(obj, "Proxy", None)
    if proxy is not None:
        tokens.append(_normalize_token(getattr(proxy, "Type", "")))
    # consider parent groups for additional context
    parents = getattr(obj, "InList", []) or []
    for parent in parents:
        for attr in ("Label", "Name", "TypeId", "IfcType"):
            tokens.append(_normalize_token(getattr(parent, attr, "")))
        parent_proxy = getattr(parent, "Proxy", None)
        if parent_proxy is not None:
            tokens.append(_normalize_token(getattr(parent_proxy, "Type", "")))
    return [t for t in tokens if t]


def _object_matches_category(obj, category, tokens):
    keywords = CATEGORY_KEYWORDS.get(category, set())
    if keywords:
        for token in tokens:
            if any(keyword in token for keyword in keywords):
                return True

    typeid = _normalize_token(getattr(obj, "TypeId", ""))
    type_hints = CATEGORY_TYPE_HINTS.get(category, set())
    if typeid and type_hints and any(hint in typeid for hint in type_hints):
        return True

    if category == "Furniture":
        return True
    return False


def _object_has_shape(obj):
    shape = getattr(obj, "Shape", None)
    if shape is not None:
        try:
            return not shape.isNull()
        except Exception:
            return True
    mesh = getattr(obj, "Mesh", None)
    return bool(mesh)


def _dedupe_objects(objs):
    out = []
    seen = set()
    for o in objs:
        key = getattr(o, "Name", None) or id(o)
        if key in seen:
            continue
        seen.add(key)
        out.append(o)
    return out


# -------------------------------
# Scene / selection helpers
# -------------------------------

def get_active_doc():
    doc = App.ActiveDocument
    if not doc:
        raise RuntimeError("No active document")
    return doc

def find_object_by_label(doc, label):
    for o in doc.Objects:
        if getattr(o, "Label", "") == label:
            return o
    return None

def collect_children_recursive(obj):
    """Return flat list of object and all descendants (supports OutList/Group)."""
    result = []
    seen = set()
    stack = [obj]

    while stack:
        current = stack.pop()
        key = getattr(current, "Name", None) or id(current)
        if key in seen:
            continue
        seen.add(key)
        result.append(current)

        for attr in ("OutList", "Group"):
            children = getattr(current, attr, None)
            if not children:
                continue
            if callable(children):
                try:
                    children = children()
                except Exception:
                    children = None
            if not children:
                continue
            if isinstance(children, (list, tuple, set)):
                stack.extend(children)
            else:
                stack.append(children)
    return _dedupe_objects(result)

def filter_by_categories(objects, cats):
    """
    cats: set like {"Walls","Floors","Roofs","Furniture","Lights","Cameras"}
    Returns objects matching selected categories. Falls back to all if nothing matches.
    """
    if not cats:
        return objects

    filtered = []
    category_order = ("Lights", "Cameras", "Walls", "Floors", "Roofs", "Furniture")
    active_categories = [cat for cat in category_order if cat in cats]

    for o in objects:
        tokens = _collect_tokens_for_object(o)
        for cat in active_categories:
            if _object_matches_category(o, cat, tokens):
                filtered.append(o)
                break

    if not filtered:
        log_warn("Category filter no encontro objetos; se exportaran todos los seleccionados.")
        return objects

    return _dedupe_objects(filtered)


# -------------------------------
# Materials (emissive) - placeholder
# -------------------------------

def apply_emissive_to_objects(objs, rgb=(1.0, 1.0, 1.0), transparency=0.0, shininess=0.2):
    """
    Placeholder. In FreeCAD, material assignment for export may depend on WB.
    The idea: bake color-like info so X3D Material.emissiveColor is meaningful.
    """
    for o in objs:
        try:
            # Example: set ViewObject properties; exporter may bake them
            if hasattr(o, "ViewObject"):
                vo = o.ViewObject
                # set a diffuse color to something, and mark emissive via custom props
                vo.ShapeColor = (rgb[0], rgb[1], rgb[2])
                vo.Transparency = int(max(0.0, min(1.0, transparency)) * 100.0)
                # custom property tag for later mapping if you implement deeper pipeline
                if not hasattr(o, "EmissiveTag"):
                    o.addProperty("App::PropertyString","EmissiveTag","GameEngine","emissive tag")
                o.EmissiveTag = f"{rgb[0]:.3f},{rgb[1]:.3f},{rgb[2]:.3f}|{shininess:.3f}"
            log_dbg(f"Applied emissive to: {o.Label}")
        except Exception as ex:
            log_warn(f"apply_emissive failed on {getattr(o,'Label','?')}: {ex}")


# -------------------------------
# Lights normalization - placeholder
# -------------------------------

def detect_lights(root_obj):
    """
    Return list of objects considered as lights (heuristic).
    """
    all_objs = collect_children_recursive(root_obj)
    return [o for o in all_objs if "light" in (getattr(o,"Label","")+getattr(o,"Name","")).lower()]

def normalize_lights(light_objs):
    """
    Placeholder: clamp intensity/range to sane defaults for CGE.
    """
    for o in light_objs:
        try:
            if not hasattr(o, "Intensity"):
                o.addProperty("App::PropertyFloat","Intensity","GameEngine","light intensity")
            if not hasattr(o, "Range"):
                o.addProperty("App::PropertyFloat","Range","GameEngine","light range")
            # clamp
            o.Intensity = max(0.0, min(5.0, getattr(o, "Intensity", 1.0)))
            o.Range = max(1.0, min(100.0, getattr(o, "Range", 10.0)))
            log_dbg(f"Normalized light: {o.Label} -> I={o.Intensity} R={o.Range}")
        except Exception as ex:
            log_warn(f"normalize_lights failed on {getattr(o,'Label','?')}: {ex}")


# -------------------------------
# GameStart marker: create simple cone arrow and store props
# -------------------------------

def create_gamestart(doc, name="GameStart"):
    """
    Create a simple marker (cone) with custom properties:
      Yaw, Pitch, Roll (deg), HeightOffset (m), FOV (deg)
    """
    if doc.getObject(name):
        log_info("GameStart already exists")
        return doc.getObject(name)

    cone = Part.makeCone(0, 100, 200)  # mm
    base = Part.makeCylinder(80, 10)   # base disk
    shape = Part.makeCompound([base, cone])
    obj = doc.addObject("Part::Feature", name)
    obj.Shape = shape
    obj.Label = "GameStart"
    # default placement: above origin
    obj.Placement.Base = App.Vector(0, 0, 1000)

    # custom properties
    obj.addProperty("App::PropertyFloat","Yaw","GameEngine","yaw deg").Yaw = 0.0
    obj.addProperty("App::PropertyFloat","Pitch","GameEngine","pitch deg").Pitch = 0.0
    obj.addProperty("App::PropertyFloat","Roll","GameEngine","roll deg").Roll = 0.0
    obj.addProperty("App::PropertyFloat","HeightOffset","GameEngine","height m").HeightOffset = 1.6
    obj.addProperty("App::PropertyFloat","FOV","GameEngine","fov deg").FOV = 60.0

    # view cosmetics
    if hasattr(obj, "ViewObject"):
        obj.ViewObject.ShapeColor = (1.0, 0.2, 0.2)
        obj.ViewObject.DisplayMode = "Flat Lines"

    doc.recompute()
    log_info("GameStart created")
    return obj


# -------------------------------
# Export helpers (X3D)
# -------------------------------

def export_objects_to_x3d(objs, filepath):
    """
    Export objs a X3D. Intenta primero ImportGui.export y, si no genera archivo,
    convierte objetos a mallas y fuerza una exportacion alternativa.
    """
    if ImportGui is None:
        raise RuntimeError("ImportGui module not available")
    if not objs:
        raise RuntimeError("No objects to export")

    target = Path(filepath)
    ensure_dir(target.parent)

    if target.exists():
        try:
            target.unlink()
        except Exception as unlink_ex:
            log_warn(f"No se pudo eliminar archivo existente: {unlink_ex}")

    try:
        ImportGui.export(objs, filepath)
        if target.exists():
            log_info(f"Exported X3D (via ImportGui): {filepath}")
        else:
            log_warn(f"ImportGui export no genero archivo en {filepath}.")
    except Exception as ex:
        log_warn(f"ImportGui.export raised exception: {ex}")

    if not target.exists() and Gui is not None and hasattr(Gui, "export"):
        try:
            Gui.export(objs, filepath)
            if target.exists():
                log_info(f"Exported X3D (via FreeCADGui.export): {filepath}")
            else:
                log_warn("FreeCADGui.export no genero archivo X3D.")
        except Exception as gui_ex:
            log_warn(f"FreeCADGui.export fallo: {gui_ex}")

    if not target.exists():
        log_warn(f"X3D no fue generado con ImportGui en {filepath}, intentando conversion mesh.")
        try:
            import Mesh
        except Exception as mesh_import_ex:
            log_err(f"Mesh module not available for fallback: {mesh_import_ex}")
        else:
            mesh_objs = []
            for o in objs:
                shape = getattr(o, "Shape", None)
                try:
                    if shape and hasattr(shape, "tessellate"):
                        mesh_obj = Mesh.Mesh(shape.tessellate(1.0))
                        if mesh_obj:
                            mesh_objs.append(mesh_obj)
                except Exception as mesh_ex:
                    log_warn(f"No se pudo convertir {getattr(o, 'Label', o)} a mesh: {mesh_ex}")
            if mesh_objs:
                try:
                    Mesh.export(mesh_objs, filepath)
                    if target.exists():
                        log_info(f"Exported X3D (via Mesh.export fallback): {filepath}")
                except Exception as ex2:
                    log_err(f"Mesh-based export fallo: {ex2}")
            else:
                log_err("No se pudo convertir objetos a mesh para exportar.")

    if not target.exists():
        raise RuntimeError(f"Export failed: archivo {filepath} no encontrado.")

def make_baseline_export(objects, out_dir, base_name):
    """
    Export provided objects as a baseline X3D to validate geometry/scale.
    """
    if not objects:
        raise RuntimeError("No objects provided for baseline export")
    out_file = str(Path(out_dir).joinpath(f"{base_name}_baseline.x3d"))
    export_objects_to_x3d(objects, out_file)
    return out_file


# -------------------------------
# Presets IO
# -------------------------------

def get_presets_dir():
    base_dir = get_param_str("export_dir", DEFAULT_EXPORT_DIR)
    pdir = Path(base_dir).joinpath(PRESETS_DIR_NAME)
    ensure_dir(pdir)
    return pdir

def save_preset(name, data):
    p = get_presets_dir().joinpath(f"{name}.json")
    with open(p, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    log_info(f"Preset saved: {p}")

def load_preset(name):
    p = get_presets_dir().joinpath(f"{name}.json")
    if not p.exists():
        raise RuntimeError("Preset not found")
    with open(p, "r", encoding="utf-8") as f:
        return json.load(f)

# -------------------------------
# Castle Game Engine helpers
# -------------------------------

def is_valid_cge_executable(path_str):
    if not path_str:
        return False
    p = Path(path_str)
    return p.exists() and p.is_file()

def launch_cge(executable_path, exported_file):
    if not is_valid_cge_executable(executable_path):
        log_warn("No se encontro la ruta de CGE.")
        return False

    exported = Path(exported_file)
    if not exported.exists():
        log_warn("Archivo exportado no encontrado para lanzar CGE.")
        return False

    try:
        if os.name == "nt":
            subprocess.Popen([executable_path, str(exported)])
        else:
            subprocess.Popen([executable_path, str(exported)])
        return True
    except Exception as ex:
        log_err(f"Launch CGE failed: {ex}")
        return False

