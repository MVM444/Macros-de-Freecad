# Qt compatibility for FreeCAD 1.x (PySide6) and older builds.
def _ensure_qt_compat():
    import sys
    import types

    QtCore = QtGui = QtWidgets = None
    binding_name = None

    for candidate in ("PySide6", "PySide2", "PySide"):
        try:
            if candidate == "PySide":
                from PySide import QtCore as _QtCore, QtGui as _QtGui
                _QtWidgets = _QtGui
            else:
                module = __import__(candidate, fromlist=["QtCore", "QtGui", "QtWidgets"])
                _QtCore = module.QtCore
                _QtGui = module.QtGui
                _QtWidgets = module.QtWidgets
            QtCore, QtGui, QtWidgets = _QtCore, _QtGui, _QtWidgets
            binding_name = candidate
            break
        except Exception:
            continue

    if QtCore is None:
        return

    qtgui_compat = types.ModuleType("QtGui")
    qtgui_compat.__dict__.update(getattr(QtGui, "__dict__", {}))
    qtgui_compat.__dict__.update(getattr(QtWidgets, "__dict__", {}))

    qtsvg_compat = None
    for module_name in ("QtSvg", "QtSvgWidgets"):
        try:
            module = __import__(binding_name, fromlist=[module_name])
            qt_module = getattr(module, module_name)
        except Exception:
            continue
        if qtsvg_compat is None:
            qtsvg_compat = types.ModuleType("QtSvg")
        qtsvg_compat.__dict__.update(getattr(qt_module, "__dict__", {}))

    qtuitools_compat = None
    try:
        module = __import__(binding_name, fromlist=["QtUiTools"])
        qtuitools_compat = module.QtUiTools
    except Exception:
        pass

    for package_name in ("PySide2", "PySide"):
        package = sys.modules.get(package_name)
        if package is None:
            package = types.ModuleType(package_name)
            sys.modules[package_name] = package
        package.QtCore = QtCore
        package.QtGui = qtgui_compat
        package.QtWidgets = QtWidgets
        sys.modules[package_name + ".QtCore"] = QtCore
        sys.modules[package_name + ".QtGui"] = qtgui_compat
        sys.modules[package_name + ".QtWidgets"] = QtWidgets
        if qtsvg_compat is not None:
            package.QtSvg = qtsvg_compat
            sys.modules[package_name + ".QtSvg"] = qtsvg_compat
        if qtuitools_compat is not None:
            package.QtUiTools = qtuitools_compat
            sys.modules[package_name + ".QtUiTools"] = qtuitools_compat


_ensure_qt_compat()

# GameEngineExport.FCMacro
# Version: 2025-10-09  (America/Costa_Rica)
# Autor: Marco + GPT
# Nota: comentarios y textos en ASCII (sin acentos) para evitar problemas en FreeCAD

import os, json, math, subprocess
from datetime import datetime
import FreeCAD as App
import FreeCADGui as Gui

# PySide2 / PySide fallback
try:
    from PySide2 import QtCore, QtGui, QtWidgets
except ImportError:
    from PySide import QtCore, QtGui
    QtWidgets = QtGui

APP_PREFIX = "[GAMEEXPORT]"
PARAM_GROUP = "User parameter:BaseApp/Preferences/GameEngineExport"

def log_info(msg):
    App.Console.PrintMessage(f"{APP_PREFIX}[INFO] {msg}\n")

def log_warn(msg):
    App.Console.PrintWarning(f"{APP_PREFIX}[WARN] {msg}\n")

def log_err(msg):
    App.Console.PrintError(f"{APP_PREFIX}[ERROR] {msg}\n")

def get_param():
    return App.ParamGet(PARAM_GROUP)

def _conf_float(spn, mn, mx, val, step=0.1, dec=3):
    spn.setRange(mn, mx)
    spn.setSingleStep(step)
    spn.setDecimals(dec)
    spn.setValue(val)

class TimePickerDialog(QtWidgets.QDialog):
    """ Dialogo simple para elegir hora:minuto (sin acentos). """
    def __init__(self, parent=None, initial=None):
        super(TimePickerDialog, self).__init__(parent)
        self.setWindowTitle("Elegir hora / Pick time")
        self.setModal(True)
        v = QtWidgets.QVBoxLayout(self)
        h = QtWidgets.QHBoxLayout()
        self.spn_h = QtWidgets.QSpinBox(); self.spn_h.setRange(0,23)
        self.spn_m = QtWidgets.QSpinBox(); self.spn_m.setRange(0,59)
        if initial is None:
            now = datetime.now()
            self.spn_h.setValue(now.hour)
            self.spn_m.setValue(now.minute)
        else:
            self.spn_h.setValue(initial[0])
            self.spn_m.setValue(initial[1])
        h.addWidget(QtWidgets.QLabel("Hora:")); h.addWidget(self.spn_h)
        h.addSpacing(12)
        h.addWidget(QtWidgets.QLabel("Min:")); h.addWidget(self.spn_m)
        v.addLayout(h)
        btns = QtWidgets.QDialogButtonBox(QtWidgets.QDialogButtonBox.Ok|QtWidgets.QDialogButtonBox.Cancel)
        btns.accepted.connect(self.accept); btns.rejected.connect(self.reject)
        v.addWidget(btns)

    def get_hm(self):
        return int(self.spn_h.value()), int(self.spn_m.value())

class GameEngineExportDialog(QtWidgets.QDialog):
    def __init__(self, parent=None):
        super(GameEngineExportDialog, self).__init__(parent)
        try:
            self.setWindowTitle("GameEngineExport - FreeCAD -> X3D (Castle Game Engine)")
            self.resize(980, 680)
            self.doc = App.ActiveDocument
            if not self.doc:
                QtWidgets.QMessageBox.warning(self, "FreeCAD", "No hay documento activo.")
                self.reject()
                return

            self.tabs = QtWidgets.QTabWidget(self)

            self.tab_scene = self._build_tab_scene()
            self.tab_materials = self._build_tab_materials()
            self.tab_config = self._build_tab_config()
            self.tab_info = self._build_tab_info()

            self.tabs.addTab(self.tab_scene, "Escena / Scene")
            self.tabs.addTab(self.tab_materials, "Materiales / Materials")
            self.tabs.addTab(self.tab_config, "Config & Perfiles")
            self.tabs.addTab(self.tab_info, "Informacion / Info")

            lay = QtWidgets.QVBoxLayout(self)
            lay.addWidget(self.tabs)

            self.status = QtWidgets.QLabel("Ready.")
            lay.addWidget(self.status)

            self._load_settings()
            self._populate_available()
            self._update_gamestart_status()
            log_info("GUI lista.")
        except Exception:
            import traceback
            log_err("__init__ failed:\n" + traceback.format_exc())
            raise

    # ----------------- GUI -----------------

