        self.btn_cge = QtWidgets.QPushButton("Examinar / Browse")
        self.btn_cge.clicked.connect(self._on_browse_cge)
        self.chk_run_cge = QtWidgets.QCheckBox("Ejecutar CGE al exportar / Run CGE after export")
        h = QtWidgets.QHBoxLayout(); h.addWidget(self.ed_cge); h.addWidget(self.btn_cge)
