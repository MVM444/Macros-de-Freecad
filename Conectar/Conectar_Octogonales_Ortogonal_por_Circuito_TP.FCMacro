# -*- coding: utf-8 -*-
# MenuText: Conectar Octogonales Ortogonal por Circuito TP...
# Icon: Conectar/Conectar_Octogonales_Ortogonal_por_Circuito_TP.svg

"""
Genera el backbone EMT interno de los circuitos TP.

- Conecta solamente cajas octogonales del mismo circuito.
- Usa un arbol minimo para enlazar todas las cajas sin cerrar ciclos.
- Reserva los puertos ocupados por bajantes y alimentadores.
- Crea rutas ortogonales sobre los muros, con curvas.
- No modifica bajantes ni alimentadores existentes.
"""

from pathlib import Path
import json
import math
import re

import FreeCAD as App
import Part


TAG = "[OCTO_ORTO_TP]"
GENERATED_BY = "Conectar_Octogonales_Ortogonal_por_Circuito_TP"
HELPER_MACRO = "Conectar_Circuitos_TP_a_Cara_Superior_Tablero.FCMacro"
PARAM_PATH = "User parameter:BaseApp/Preferences/Mod/ElectricCR/OctoOrtoTP"
DEFAULT_ROUTE_Z = 3300.0
DEFAULT_BEND_RADIUS = 100.0
DEFAULT_PORT_STUB = 80.0
DEFAULT_DIAMETER = 22.2
EPS = 1e-7


def _load_helpers():
    path = Path(__file__).resolve().with_name(HELPER_MACRO)
    if not path.exists():
        raise RuntimeError("No se encontro la macro auxiliar: " + str(path))
    source = path.read_text(encoding="utf-8-sig")
    source = re.sub(
        r"\nif\s+__name__\s*==\s*[\"']__main__[\"']\s*:\s*\n\s*main\(\)\s*\Z",
        "\n",
        source,
        flags=re.MULTILINE,
    )
    namespace = {"__name__": "_electriccr_tp_top_helpers", "__file__": str(path)}
    exec(compile(source, str(path), "exec"), namespace, namespace)
    return namespace


_H = _load_helpers()
Gui = _H.get("Gui")
GUI_UP = bool(_H.get("GUI_UP", False))
QtWidgets = _H.get("QtWidgets")


def _log(message):
    App.Console.PrintMessage(TAG + " " + str(message) + "\n")


def _warn(message):
    App.Console.PrintWarning(TAG + " " + str(message) + "\n")


def _err(message):
    App.Console.PrintError(TAG + " " + str(message) + "\n")


def _safe(value):
    try:
        return str(value or "")
    except Exception:
        return ""


def _ensure_property(obj, ptype, name, group, description):
    if name not in getattr(obj, "PropertiesList", []):
        obj.addProperty(ptype, name, group, description)


def _box_center_xy(box):
    bb = box.Shape.BoundBox
    return App.Vector(float(bb.Center.x), float(bb.Center.y), float(bb.Center.z))


def _distance_xy(a, b):
    return math.hypot(float(a.x - b.x), float(a.y - b.y))


def _minimum_spanning_edges(boxes, root_box=None):
    nodes = list(boxes or [])
    if len(nodes) < 2:
        return []
    root = root_box if root_box in nodes else nodes[0]
    visited = {root.Name}
    edges = []
    while len(visited) < len(nodes):
        best = None
        for source in nodes:
            if source.Name not in visited:
                continue
            pa = _box_center_xy(source)
            for destination in nodes:
                if destination.Name in visited:
                    continue
                pb = _box_center_xy(destination)
                weight = _distance_xy(pa, pb)
                candidate = (weight, source.Name, destination.Name, source, destination)
                if best is None or candidate[:3] < best[:3]:
                    best = candidate
        if best is None:
            raise RuntimeError("No se pudo completar el arbol de octogonales.")
        _weight, _sname, _dname, source, destination = best
        edges.append((source, destination))
        visited.add(destination.Name)
    return edges


def _feeder_root_for_circuit(doc, circuit_id, boxes):
    for obj in doc.Objects:
        if _safe(getattr(obj, "GeneradoPor", "")) != "Conectar_Circuitos_TP_a_Cara_Superior_Tablero":
            continue
        if _safe(getattr(obj, "CircuitoID", "")) != circuit_id:
            continue
        box = getattr(obj, "CajaOrigen", None)
        if box in boxes:
            return box
    return None


def _reserved_ports(doc, boxes):
    box_names = {box.Name for box in boxes}
    reserved = {name: set() for name in box_names}
    for obj in doc.Objects:
        # Los ramales de esta misma herramienta se recalculan desde cero; no
        # deben reservar contra si mismos al actualizar una ejecucion previa.
        if _safe(getattr(obj, "GeneradoPor", "")) == GENERATED_BY:
            continue
        # Bajantes de tomas: CajaDestino se guarda como Name y PuertoDestino.
        destination_name = _safe(getattr(obj, "CajaDestino", ""))
        destination_port = _safe(getattr(obj, "PuertoDestino", ""))
        if destination_name in reserved and destination_port:
            reserved[destination_name].add(destination_port)

        # Alimentadores: CajaOrigen es Link y PuertoOrigen es el puerto usado.
        source_box = getattr(obj, "CajaOrigen", None)
        source_port = _safe(getattr(obj, "PuertoOrigen", ""))
        if source_box is not None and getattr(source_box, "Name", "") in reserved and source_port:
            reserved[source_box.Name].add(source_port)
    return reserved


def _normalize_xy(vector):
    length = math.hypot(float(vector.x), float(vector.y))
    if length <= EPS:
        return App.Vector(1.0, 0.0, 0.0)
    return App.Vector(float(vector.x) / length, float(vector.y) / length, 0.0)


def _choose_port(box, toward_point, used_names):
    ports = [p for p in _H["_box_ports_world"](box) if p["name"].lower() != "bottom"]
    if not ports:
        bb = box.Shape.BoundBox
        point = App.Vector(bb.Center.x, bb.Center.y, bb.ZMax)
        return point, _normalize_xy(toward_point - point), "Superior"

    def score(port):
        direction = _normalize_xy(port["dir"])
        toward = _normalize_xy(toward_point - port["point"])
        used_rank = 1 if port["name"] in used_names else 0
        alignment = float(direction.dot(toward))
        return (used_rank, -alignment, _distance_xy(port["point"], toward_point), port["name"])

    chosen = sorted(ports, key=score)[0]
    return chosen["point"], _normalize_xy(chosen["dir"]), chosen["name"]


def _route_candidates(p2, q2):
    z = float(p2.z)
    return [
        [p2, App.Vector(q2.x, p2.y, z), q2],
        [p2, App.Vector(p2.x, q2.y, z), q2],
    ]


def _segment_distance_xy(point, a, b):
    ax, ay = float(a.x), float(a.y)
    bx, by = float(b.x), float(b.y)
    px, py = float(point.x), float(point.y)
    dx, dy = bx - ax, by - ay
    length2 = dx * dx + dy * dy
    if length2 <= EPS:
        return math.hypot(px - ax, py - ay)
    t = ((px - ax) * dx + (py - ay) * dy) / length2
    t = max(0.0, min(1.0, t))
    return math.hypot(px - (ax + t * dx), py - (ay + t * dy))


def _candidate_penalty(points, boxes, endpoint_names):
    penalty = 0.0
    for box in boxes:
        if box.Name in endpoint_names:
            continue
        center = _box_center_xy(box)
        for a, b in zip(points[:-1], points[1:]):
            distance = _segment_distance_xy(center, a, b)
            if distance < 120.0:
                penalty += (120.0 - distance) * 10.0
    length = sum(a.distanceToPoint(b) for a, b in zip(points[:-1], points[1:]))
    return penalty + length


def _branch_route(source, destination, source_port, source_dir, destination_port, destination_dir, boxes, cfg):
    route_z = max(float(cfg["route_z"]), float(source_port.z) + 50.0, float(destination_port.z) + 50.0)
    stub = float(cfg["port_stub"])
    p0 = App.Vector(source_port)
    p1 = App.Vector(p0.x + source_dir.x * stub, p0.y + source_dir.y * stub, p0.z)
    p2 = App.Vector(p1.x, p1.y, route_z)
    q0 = App.Vector(destination_port)
    q1 = App.Vector(q0.x + destination_dir.x * stub, q0.y + destination_dir.y * stub, q0.z)
    q2 = App.Vector(q1.x, q1.y, route_z)
    candidates = _route_candidates(p2, q2)
    middle = min(
        candidates,
        key=lambda points: _candidate_penalty(points, boxes, {source.Name, destination.Name}),
    )
    points = [p0, p1] + middle + [q1, q0]
    return _H["_simplify_collinear"](points)


def _connection_key(circuit_id, source, destination):
    names = sorted((source.Name, destination.Name))
    return circuit_id + "|" + names[0] + "|" + names[1]


def _find_existing(doc, key):
    for obj in doc.Objects:
        if _safe(getattr(obj, "GeneradoPor", "")) == GENERATED_BY and _safe(getattr(obj, "ConexionKey", "")) == key:
            return obj
    return None


def _ensure_branch_group(doc, circuit_group, circuit_id):
    label = "Ramales EMT " + circuit_id
    for child in list(getattr(circuit_group, "Group", []) or []):
        if hasattr(child, "Group") and _safe(getattr(child, "Label", "")) == label:
            return child
    name = "Grupo_Ramales_EMT_" + circuit_id.replace("-", "_")
    name = _H["_unique_name"](doc, name)
    group = doc.addObject("App::DocumentObjectGroup", name)
    group.Label = label
    _ensure_property(group, "App::PropertyString", "GeneradoPor", "ElectricCR", "Generador")
    group.GeneradoPor = GENERATED_BY
    circuit_group.addObject(group)
    return group


def _move_to_group(obj, group):
    for parent in list(getattr(obj, "InList", []) or []):
        if parent is group or not hasattr(parent, "Group"):
            continue
        if _safe(getattr(parent, "GeneradoPor", "")) == GENERATED_BY:
            try:
                parent.removeObject(obj)
            except Exception:
                pass
    group.addObject(obj)


def _style(obj):
    view = getattr(obj, "ViewObject", None)
    if view is None:
        return
    try:
        color = (0.10, 0.72, 0.95)
        view.LineColor = color
        view.PointColor = color
        view.ShapeColor = color
        view.LineWidth = 3.0
    except Exception:
        pass


def _write_branch(doc, circuit_group, circuit_id, index, source, destination, source_data, destination_data, points, cfg):
    source_point, _source_dir, source_port_name = source_data
    destination_point, _destination_dir, destination_port_name = destination_data
    key = _connection_key(circuit_id, source, destination)
    obj = _find_existing(doc, key)
    created = obj is None
    if obj is None:
        name = "Ramal_%s_%02d" % (circuit_id.replace("-", "_"), index)
        obj = doc.addObject("Part::Feature", _H["_unique_name"](doc, name))
    obj.Label = "Ramal %s: %s -> %s" % (circuit_id, source.Label, destination.Label)
    obj.Shape = _H["_rounded_wire"](points, float(cfg["bend_radius"]))

    properties = [
        ("App::PropertyString", "GeneradoPor", "ElectricCR", "Generador"),
        ("App::PropertyString", "CircuitoID", "ElectricCR", "Circuito"),
        ("App::PropertyString", "ConexionKey", "ElectricCR", "Clave idempotente"),
        ("App::PropertyString", "TipoConexion", "ElectricCR", "Tipo"),
        ("App::PropertyString", "ConduitType", "ElectricCR", "Tuberia"),
        ("App::PropertyFloat", "DiametroEMT", "ElectricCR", "Diametro"),
        ("App::PropertyLink", "CajaOrigen", "Vinculos", "Caja origen"),
        ("App::PropertyLink", "CajaDestinoLink", "Vinculos", "Caja destino"),
        ("App::PropertyString", "PuertoOrigen", "Puertos", "Puerto origen"),
        ("App::PropertyString", "PuertoDestino", "Puertos", "Puerto destino"),
        ("App::PropertyVector", "PuntoOrigen", "Puertos", "Punto inicial"),
        ("App::PropertyVector", "PuntoDestino", "Puertos", "Punto final"),
        ("App::PropertyFloat", "AlturaRuta", "Ruta", "Cota superior"),
        ("App::PropertyString", "RutaJSON", "Ruta", "Puntos mundiales"),
        ("App::PropertyString", "EstadoConexion", "Ruta", "Estado"),
    ]
    for ptype, name, group_name, description in properties:
        _ensure_property(obj, ptype, name, group_name, description)
    obj.GeneradoPor = GENERATED_BY
    obj.CircuitoID = circuit_id
    obj.ConexionKey = key
    obj.TipoConexion = "EMT_Ortogonal_Octogonal"
    obj.ConduitType = "EMT"
    obj.DiametroEMT = float(cfg["diameter"])
    obj.CajaOrigen = source
    obj.CajaDestinoLink = destination
    obj.PuertoOrigen = source_port_name
    obj.PuertoDestino = destination_port_name
    obj.PuntoOrigen = App.Vector(source_point)
    obj.PuntoDestino = App.Vector(destination_point)
    obj.AlturaRuta = float(cfg["route_z"])
    obj.RutaJSON = json.dumps([[p.x, p.y, p.z] for p in points], separators=(",", ":"))
    obj.EstadoConexion = "Conectado"
    _style(obj)
    group = _ensure_branch_group(doc, circuit_group, circuit_id)
    _move_to_group(obj, group)
    return obj, created


def _delete_stale(doc, valid_keys):
    stale = [
        obj for obj in doc.Objects
        if _safe(getattr(obj, "GeneradoPor", "")) == GENERATED_BY
        and not hasattr(obj, "Group")
        and _safe(getattr(obj, "ConexionKey", "")) not in valid_keys
    ]
    for obj in stale:
        doc.removeObject(obj.Name)
    return len(stale)


def _cleanup_empty_groups(doc):
    for group in list(doc.Objects):
        if not hasattr(group, "Group"):
            continue
        if _safe(getattr(group, "GeneradoPor", "")) != GENERATED_BY:
            continue
        if not list(group.Group):
            doc.removeObject(group.Name)


def _default_cfg():
    prefs = App.ParamGet(PARAM_PATH)
    return {
        "route_z": float(prefs.GetFloat("route_z", DEFAULT_ROUTE_Z)),
        "bend_radius": float(prefs.GetFloat("bend_radius", DEFAULT_BEND_RADIUS)),
        "port_stub": float(prefs.GetFloat("port_stub", DEFAULT_PORT_STUB)),
        "diameter": float(prefs.GetFloat("diameter", DEFAULT_DIAMETER)),
    }


def _save_cfg(cfg):
    prefs = App.ParamGet(PARAM_PATH)
    for key in ("route_z", "bend_radius", "port_stub", "diameter"):
        prefs.SetFloat(key, float(cfg[key]))


def _run_dialog(circuit_map):
    cfg = _default_cfg()
    if (not GUI_UP) or QtWidgets is None:
        return cfg
    total_boxes = sum(len(data[1]) for data in circuit_map.values())
    expected = sum(max(0, len(data[1]) - 1) for data in circuit_map.values())
    dlg = QtWidgets.QDialog(Gui.getMainWindow())
    dlg.setWindowTitle("Octogonales ortogonales por circuito TP")
    dlg.setMinimumWidth(520)
    info = QtWidgets.QLabel(
        "Circuitos: {} | Cajas: {} | Ramales previstos: {}\n"
        "Se conectan solamente octogonales del mismo circuito."
        .format(len(circuit_map), total_boxes, expected)
    )
    info.setWordWrap(True)
    form = QtWidgets.QFormLayout()
    controls = {}
    specs = [
        ("route_z", "Altura de ramales:", 3001.0, 10000.0),
        ("bend_radius", "Radio de curvas:", 0.0, 1000.0),
        ("port_stub", "Salida recta desde caja:", 10.0, 500.0),
        ("diameter", "Diametro EMT:", 1.0, 200.0),
    ]
    for key, label, minimum, maximum in specs:
        spin = QtWidgets.QDoubleSpinBox()
        spin.setRange(minimum, maximum)
        spin.setDecimals(1)
        spin.setSuffix(" mm")
        spin.setValue(float(cfg[key]))
        controls[key] = spin
        form.addRow(label, spin)
    buttons = QtWidgets.QDialogButtonBox(QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel)
    buttons.accepted.connect(dlg.accept)
    buttons.rejected.connect(dlg.reject)
    layout = QtWidgets.QVBoxLayout(dlg)
    layout.addWidget(info)
    layout.addLayout(form)
    layout.addWidget(buttons)
    execute = getattr(dlg, "exec", None) or getattr(dlg, "exec_", None)
    if execute() != QtWidgets.QDialog.Accepted:
        return None
    for key, control in controls.items():
        cfg[key] = float(control.value())
    _save_cfg(cfg)
    return cfg


def main(doc_override=None, cfg_override=None):
    doc = doc_override or App.ActiveDocument
    if doc is None:
        _err("No hay documento activo.")
        return None
    circuit_map = _H["_find_circuit_groups"](doc)
    if not circuit_map:
        _warn("No se encontraron circuitos TP con cajas octogonales.")
        return None
    cfg = dict(cfg_override) if cfg_override is not None else _run_dialog(circuit_map)
    if cfg is None:
        _warn("Operacion cancelada.")
        return None
    for key, fallback in (
        ("route_z", DEFAULT_ROUTE_Z),
        ("bend_radius", DEFAULT_BEND_RADIUS),
        ("port_stub", DEFAULT_PORT_STUB),
        ("diameter", DEFAULT_DIAMETER),
    ):
        cfg[key] = float(cfg.get(key, fallback))
    cfg["route_z"] = max(3001.0, cfg["route_z"])

    all_boxes = []
    for _group, boxes in circuit_map.values():
        all_boxes.extend(boxes)
    reserved = _reserved_ports(doc, all_boxes)
    used = {name: set(values) for name, values in reserved.items()}

    plans = []
    for number in sorted(circuit_map):
        circuit_group, boxes = circuit_map[number]
        circuit_id = "TP-%03d" % number
        root = _feeder_root_for_circuit(doc, circuit_id, boxes)
        edges = _minimum_spanning_edges(boxes, root_box=root)
        plans.append((circuit_group, circuit_id, boxes, edges))

    valid_keys = set()
    created = updated = 0
    branches = []
    doc.openTransaction("ElectricCR: conectar octogonales ortogonal por circuito TP")
    try:
        for circuit_group, circuit_id, boxes, edges in plans:
            for index, (source, destination) in enumerate(edges, start=1):
                source_data = _choose_port(source, _box_center_xy(destination), used[source.Name])
                used[source.Name].add(source_data[2])
                destination_data = _choose_port(destination, _box_center_xy(source), used[destination.Name])
                used[destination.Name].add(destination_data[2])
                points = _branch_route(
                    source,
                    destination,
                    source_data[0],
                    source_data[1],
                    destination_data[0],
                    destination_data[1],
                    boxes,
                    cfg,
                )
                obj, was_created = _write_branch(
                    doc,
                    circuit_group,
                    circuit_id,
                    index,
                    source,
                    destination,
                    source_data,
                    destination_data,
                    points,
                    cfg,
                )
                branches.append(obj)
                valid_keys.add(obj.ConexionKey)
                created += 1 if was_created else 0
                updated += 0 if was_created else 1
            _log("{} | cajas={} | ramales={}".format(circuit_id, len(boxes), len(edges)))
        deleted = _delete_stale(doc, valid_keys)
        _cleanup_empty_groups(doc)
        doc.recompute()
        doc.commitTransaction()
    except Exception as exc:
        try:
            doc.abortTransaction()
        except Exception:
            pass
        _err("Fallo general: " + str(exc))
        return None

    result = {
        "circuitos": len(plans),
        "cajas": len(all_boxes),
        "ramales": len(branches),
        "creados": created,
        "actualizados": updated,
        "eliminados_obsoletos": deleted,
        "circuitos_una_caja": [cid for _group, cid, boxes, edges in plans if len(boxes) == 1],
    }
    _log("Finalizado: " + json.dumps(result, ensure_ascii=False))
    return result


if __name__ == "__main__":
    main()
