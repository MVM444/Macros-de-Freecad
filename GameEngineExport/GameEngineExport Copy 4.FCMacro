        w = QtWidgets.QWidget()
        v = QtWidgets.QVBoxLayout(w)

        # Raiz (opcional)
        grp_root = QtWidgets.QGroupBox("Raiz de escena (opcional) / Scene root (optional)")
        froot = QtWidgets.QFormLayout(grp_root)
        self.ed_root = QtWidgets.QLineEdit()
        self.btn_take_root = QtWidgets.QPushButton("Tomar seleccion / Pick selected")
        self.btn_take_root.clicked.connect(self._on_take_root)
        froot.addRow("Raiz (Label/Name):", self.ed_root)
        froot.addRow("", self.btn_take_root)
        v.addWidget(grp_root)

        # Objetos a exportar
        grp_objs = QtWidgets.QGroupBox("Objetos a exportar / Objects to export")
        vobjs = QtWidgets.QVBoxLayout(grp_objs)
        tip = QtWidgets.QLabel("Mueva manualmente los objetos a exportar. Use Actualizar y Limpiar segun sea necesario.")
        tip.setWordWrap(True)
        vobjs.addWidget(tip)

        tools = QtWidgets.QHBoxLayout()
