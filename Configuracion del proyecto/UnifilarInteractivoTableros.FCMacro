# -*- coding: utf-8 -*-
# =============================================================================
# Name: UnifilarInteractivoTableros.FCMacro
# Purpose:
#   Prototype of an interactive single-line electrical diagram viewer/editor
#   for ElectricCR inside FreeCAD.
#
# Main behavior:
#   - Opens a Visio-like 2D window inside the FreeCAD MDI area when possible.
#   - Provides a symbol palette for service entry, grounding, panelboards,
#     breakers, surge protection (SPD), and UPS.
#   - Symbols can be moved, selected, renamed, connected, and deleted.
#   - The scene is driven by a JSON-compatible logical model.
#   - The current scene can be exported to SVG for future TechDraw use.
#
# Modification rules:
#   - Keep the logical model independent from FreeCADGui and Qt whenever
#     practical. Future model readers should return the same JSON-compatible
#     structure consumed by UnifilarWidget.load_model().
#   - Do not scan every FreeCAD object from the renderer. Electrical discovery
#     belongs in a separate adapter/core layer.
#   - Preserve existing working behavior when extending this file.
#   - Internal identifiers and property names should remain ASCII-safe.
#
# Version: 0.1.0
# Date: 2026-09-10 20:32 -0600 (Costa Rica)
# Target: FreeCAD 1.1.3
# =============================================================================

from __future__ import annotations

import math

import FreeCAD as App
import FreeCADGui as Gui

try:
    from PySide import QtCore, QtGui, QtWidgets
    try:
        from PySide import QtSvg
    except Exception:
        QtSvg = None
except Exception:
    try:
        from PySide6 import QtCore, QtGui, QtWidgets, QtSvg
    except Exception:
        from PySide2 import QtCore, QtGui, QtWidgets, QtSvg


APP_TITLE = "ElectricCR - Unifilar interactivo"
LOG_PREFIX = "[ElectricCR.Unifilar]"


# -----------------------------------------------------------------------------
# Compatibility helpers
# -----------------------------------------------------------------------------

def _enum(owner, direct_name, scoped_name, member_name):
    """Return a Qt enum member compatible with PySide2/PySide6 style APIs."""
    direct = getattr(owner, direct_name, None)
    if direct is not None:
        return direct
    scoped = getattr(owner, scoped_name)
    return getattr(scoped, member_name)


def _qt_flag(direct_name, scoped_name, member_name):
    return _enum(QtCore.Qt, direct_name, scoped_name, member_name)


def _gitem_flag(direct_name, member_name):
    direct = getattr(QtWidgets.QGraphicsItem, direct_name, None)
    if direct is not None:
        return direct
    return getattr(QtWidgets.QGraphicsItem.GraphicsItemFlag, member_name)


def _gitem_change(direct_name, member_name):
    direct = getattr(QtWidgets.QGraphicsItem, direct_name, None)
    if direct is not None:
        return direct
    return getattr(QtWidgets.QGraphicsItem.GraphicsItemChange, member_name)


def _view_drag_mode(direct_name, member_name):
    direct = getattr(QtWidgets.QGraphicsView, direct_name, None)
    if direct is not None:
        return direct
    return getattr(QtWidgets.QGraphicsView.DragMode, member_name)


def _painter_hint(direct_name, member_name):
    direct = getattr(QtGui.QPainter, direct_name, None)
    if direct is not None:
        return direct
    return getattr(QtGui.QPainter.RenderHint, member_name)


def _frame_shape(direct_name, member_name):
    direct = getattr(QtWidgets.QFrame, direct_name, None)
    if direct is not None:
        return direct
    return getattr(QtWidgets.QFrame.Shape, member_name)


def _message_icon(direct_name, member_name):
    direct = getattr(QtWidgets.QMessageBox, direct_name, None)
    if direct is not None:
        return direct
    return getattr(QtWidgets.QMessageBox.Icon, member_name)


def _standard_button(direct_name, member_name):
    direct = getattr(QtWidgets.QMessageBox, direct_name, None)
    if direct is not None:
        return direct
    return getattr(QtWidgets.QMessageBox.StandardButton, member_name)


ALIGN_CENTER = _qt_flag("AlignCenter", "AlignmentFlag", "AlignCenter")
ALIGN_LEFT = _qt_flag("AlignLeft", "AlignmentFlag", "AlignLeft")
ALIGN_VCENTER = _qt_flag("AlignVCenter", "AlignmentFlag", "AlignVCenter")
KEEP_ASPECT = _qt_flag("KeepAspectRatio", "AspectRatioMode", "KeepAspectRatio")
CTRL_MOD = _qt_flag("ControlModifier", "KeyboardModifier", "ControlModifier")
WA_DELETE_ON_CLOSE = _qt_flag(
    "WA_DeleteOnClose", "WidgetAttribute", "WA_DeleteOnClose"
)

ITEM_MOVABLE = _gitem_flag("ItemIsMovable", "ItemIsMovable")
ITEM_SELECTABLE = _gitem_flag("ItemIsSelectable", "ItemIsSelectable")
ITEM_SENDS_GEOMETRY = _gitem_flag(
    "ItemSendsGeometryChanges", "ItemSendsGeometryChanges"
)
ITEM_POSITION_CHANGED = _gitem_change(
    "ItemPositionHasChanged", "ItemPositionHasChanged"
)
RUBBER_BAND_DRAG = _view_drag_mode("RubberBandDrag", "RubberBandDrag")
ANTIALIASING = _painter_hint("Antialiasing", "Antialiasing")
NO_FRAME = _frame_shape("NoFrame", "NoFrame")


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

def log(message):
    text = "%s %s" % (LOG_PREFIX, message)
    try:
        App.Console.PrintMessage(text + "\n")
    except Exception:
        print(text)


def warn(message):
    text = "%s WARNING: %s" % (LOG_PREFIX, message)
    try:
        App.Console.PrintWarning(text + "\n")
    except Exception:
        print(text)


