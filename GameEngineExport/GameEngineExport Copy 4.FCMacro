        v.addWidget(grp_out)

        # Luz global
        grp_gl = QtWidgets.QGroupBox("Iluminacion (Luz global) / Lighting (Global light)")
        fgl = QtWidgets.QFormLayout(grp_gl)
        self.chk_gl = QtWidgets.QCheckBox("Activar luz global / Enable global light")
        self.cmb_gl_type = QtWidgets.QComboBox(); self.cmb_gl_type.addItems(["Directional (Sun)"])
        self.spn_gl_int = QtWidgets.QDoubleSpinBox(); _conf_float(self.spn_gl_int, 0.0, 5.0, 1.2, 0.1, 2)
        # color
        self.frm_gl_color = QtWidgets.QFrame(); self.frm_gl_color.setFrameShape(QtWidgets.QFrame.Box)
        self.frm_gl_color.setAutoFillBackground(True); self._set_color(QtGui.QColor(255,255,255))
        self.btn_gl_color = QtWidgets.QPushButton("Color...")
        self.btn_gl_color.clicked.connect(self._on_pick_color)
        hcolor = QtWidgets.QHBoxLayout(); hcolor.addWidget(self.frm_gl_color); hcolor.addWidget(self.btn_gl_color); hcolor.addStretch(1)
        # direccion
        self.spn_gl_yaw = QtWidgets.QDoubleSpinBox(); _conf_float(self.spn_gl_yaw, 0.0, 360.0, 135.0, 1.0, 1)
        self.spn_gl_pitch = QtWidgets.QDoubleSpinBox(); _conf_float(self.spn_gl_pitch, -90.0, 90.0, -35.0, 1.0, 1)
        hypr = QtWidgets.QHBoxLayout(); hypr.addWidget(QtWidgets.QLabel("Yaw (deg):")); hypr.addWidget(self.spn_gl_yaw)
        hypr.addSpacing(12); hypr.addWidget(QtWidgets.QLabel("Pitch (deg):")); hypr.addWidget(self.spn_gl_pitch); hypr.addStretch(1)
        # latitud y botones Sol
        self.spn_lat = QtWidgets.QDoubleSpinBox(); _conf_float(self.spn_lat, -90.0, 90.0, 9.9, 0.1, 2)
        self.btn_sun_local = QtWidgets.QPushButton("Usar sol (hora local)")
        self.btn_sun_pick = QtWidgets.QPushButton("Hora...")
        self.btn_sun_local.clicked.connect(self._on_set_solar_local)
        self.btn_sun_pick.clicked.connect(self._on_set_solar_picktime)
        hsun = QtWidgets.QHBoxLayout()
        hsun.addWidget(QtWidgets.QLabel("Latitud (deg):")); hsun.addWidget(self.spn_lat); hsun.addStretch(1)
        hsun.addWidget(self.btn_sun_local); hsun.addWidget(self.btn_sun_pick)

        fgl.addRow("", self.chk_gl)
        fgl.addRow("Tipo / Type:", self.cmb_gl_type)
        fgl.addRow("Intensidad / Intensity:", self.spn_gl_int)
        fgl.addRow("Color:", self._wrap(hcolor))
        fgl.addRow("Direccion:", self._wrap(hypr))
        fgl.addRow("", self._wrap(hsun))
        v.addWidget(grp_gl)

        # GameStart
        grp_gs = QtWidgets.QGroupBox("GameStart (Viewpoint inicial)")
        hgs = QtWidgets.QHBoxLayout(grp_gs)
        self.ed_gs = QtWidgets.QLineEdit()
        self.ed_gs.setPlaceholderText("GameStart")
        self.btn_gs = QtWidgets.QPushButton("Crear / Create")
        self.btn_gs.clicked.connect(self._on_create_gamestart)
        self.lbl_gs = QtWidgets.QLabel("")
        hgs.addWidget(QtWidgets.QLabel("Nombre:")); hgs.addWidget(self.ed_gs)
        hgs.addWidget(self.btn_gs); hgs.addWidget(self.lbl_gs)
        v.addWidget(grp_gs)

        # Exportar
        self.btn_export = QtWidgets.QPushButton("Exportar X3D / Export X3D")
        self.btn_export.setStyleSheet("font-weight: bold;")
        self.btn_export.clicked.connect(self._on_export)
        v.addWidget(self.btn_export)

        note = QtWidgets.QLabel("Escala 0.001 (FreeCAD mm -> CGE m). Asegure piso para navegar. Evite caracteres especiales en nombres.")
        note.setStyleSheet("color: gray;")
        v.addWidget(note); v.addStretch(1)
        return w

