    def _build_tab_info(self):
        w = QtWidgets.QWidget()
        v = QtWidgets.QVBoxLayout(w)
        self.info = QtWidgets.QPlainTextEdit()
        self.info.setReadOnly(True)
        self.info.setPlainText(
            "GameEngineExport - FreeCAD -> X3D (Castle Game Engine)\n"
            "Pasos: seleccione objetos, configure luz global y GameStart, exporte X3D.\n"
            "Se guardan ajustes en ParamGet y en <Proyecto>.gee.json.\n\n"
            "Created by Ing. Marco Vinicio Mora Fallas with ChatGPT support (99.9%).\n"
            "Version: 2025-10-09 (America/Costa_Rica)\n"
        )
        self.btn_info_copy = QtWidgets.QPushButton("Copiar informacion")
        self.btn_info_copy.clicked.connect(lambda: QtWidgets.QApplication.clipboard().setText(self.info.toPlainText()))
        v.addWidget(self.info)
        h = QtWidgets.QHBoxLayout(); h.addStretch(1); h.addWidget(self.btn_info_copy)
        v.addLayout(h)
