    # ---------- Settings tab ----------
    def _build_tab_settings(self):
        w = QtWidgets.QWidget()
        lay = QtWidgets.QFormLayout(w)

        self.ed_default_dir = QtWidgets.QLineEdit(get_param_str("export_dir_default", DEFAULT_EXPORT_DIR))
        self.ed_suffix = QtWidgets.QLineEdit(get_param_str("file_suffix", ""))

        self.chk_restore = QtWidgets.QCheckBox("Restore last session / Restaurar ultima sesion")
        self.chk_restore.setChecked(get_param_bool("restore_last", True))

        self.ed_cge_path = QtWidgets.QLineEdit(get_param_str("cge_executable_path", ""))
        tooltip = "Seleccione el ejecutable del Castle Game Engine. Ejemplo: C:\\CastleEngine\\castle-engine.exe"
        self.ed_cge_path.setToolTip(tooltip)
        self.btn_cge_browse = QtWidgets.QPushButton("Browse / Examinar")
        self.btn_cge_browse.setToolTip(tooltip)
        self.btn_cge_browse.clicked.connect(self._browse_cge_executable)

        self.chk_auto_launch_cge = QtWidgets.QCheckBox("Run Castle Game Engine after export / Ejecutar Castle Game Engine al exportar")
        self.chk_auto_launch_cge.setChecked(get_param_bool("auto_launch_cge", False))
        self.chk_auto_launch_cge.setToolTip("Ejecuta Castle Game Engine automaticamente despues de exportar")

        lay.addRow("Default export folder / Carpeta por defecto:", self.ed_default_dir)
        lay.addRow("Filename suffix / Sufijo:", self.ed_suffix)
