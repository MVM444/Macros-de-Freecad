        lay = QtWidgets.QVBoxLayout(w)

        intro = QtWidgets.QLabel(
            "This macro exports scenes to X3D for Castle Game Engine.\n"
            "Esta macro exporta escenas a X3D para Castle Game Engine.\n\n"
            "Tips:\n"
            "- Select a specific scene root group or only the objects you want to export. Do not select the entire document.\n"
            "- Seleccione un grupo raiz especifico o solo los objetos que desea exportar. No seleccione el documento completo.\n"
            "- FreeCAD units are millimeters; export runs in meters (scale 0.001).\n"
            "- FreeCAD trabaja en milimetros; la exportacion se realiza en metros (escala 0.001)."
        )
        intro.setWordWrap(True)
