# -*- coding: utf-8 -*-
"""
GameEngineExport.FCMacro
Version: 2025-10-04 20:00 (America/Costa_Rica)
Author: Marco + GPT

Descripcion / Description:
  Macro unificada para exportar escenas desde FreeCAD hacia motores de juego (X3D para Castle Game Engine).
  Unifica tres funciones base: materiales (emissive), luces, y export de escena.
  Agrega un objeto marcador de inicio "GameStart" que se exporta como X3D Viewpoint.
  GUI con pestanas y microcopy bilingue (ES/EN). Guarda configuraciones con ParamGet y soporta presets JSON.

Notas importantes (ES):
  - FreeCAD trabaja en mm. El X3D objetivo es en metros. Se aplica factor 0.001.
  - Seleccione un grupo raiz especifico (no el documento completo).
  - Debe existir al menos un "piso" para la navegacion del personaje.
  - Evitar nombres con acentos, espacios raros o caracteres especiales en archivos/salidas.

Important notes (EN):
  - FreeCAD units are millimeters; X3D targets meters. Scale factor 0.001 is applied.
  - Select a specific scene root group (not the whole document).
  - At least one floor surface is required for player navigation.
  - Avoid special characters in file names/paths.

References:
  - FreeCAD X3D export (selection + Mesh WB): forum threads and docs. [see citations in chat]
  - ParamGet for preferences. [see citations in chat]
  - X3D Material.emissiveColor; CGE lights and Viewpoint. [see citations in chat]
"""

# Qt compatibility for FreeCAD 1.x (PySide6) and older builds.
def _ensure_qt_compat():
    import sys
    import types

    QtCore = QtGui = QtWidgets = None
    binding_name = None

    for candidate in ("PySide6", "PySide2", "PySide"):
        try:
            if candidate == "PySide":
                from PySide import QtCore as _QtCore, QtGui as _QtGui
                _QtWidgets = _QtGui
            else:
                module = __import__(candidate, fromlist=["QtCore", "QtGui", "QtWidgets"])
                _QtCore = module.QtCore
                _QtGui = module.QtGui
                _QtWidgets = module.QtWidgets
            QtCore, QtGui, QtWidgets = _QtCore, _QtGui, _QtWidgets
            binding_name = candidate
            break
        except Exception:
            continue

    if QtCore is None:
        return

    qtgui_compat = types.ModuleType("QtGui")
    qtgui_compat.__dict__.update(getattr(QtGui, "__dict__", {}))
    qtgui_compat.__dict__.update(getattr(QtWidgets, "__dict__", {}))

    qtsvg_compat = None
    for module_name in ("QtSvg", "QtSvgWidgets"):
        try:
            module = __import__(binding_name, fromlist=[module_name])
            qt_module = getattr(module, module_name)
        except Exception:
            continue
        if qtsvg_compat is None:
            qtsvg_compat = types.ModuleType("QtSvg")
        qtsvg_compat.__dict__.update(getattr(qt_module, "__dict__", {}))

    qtuitools_compat = None
    try:
        module = __import__(binding_name, fromlist=["QtUiTools"])
        qtuitools_compat = module.QtUiTools
    except Exception:
        pass

    for package_name in ("PySide2", "PySide"):
        package = sys.modules.get(package_name)
        if package is None:
            package = types.ModuleType(package_name)
            sys.modules[package_name] = package
        package.QtCore = QtCore
        package.QtGui = qtgui_compat
        package.QtWidgets = QtWidgets
        sys.modules[package_name + ".QtCore"] = QtCore
        sys.modules[package_name + ".QtGui"] = qtgui_compat
        sys.modules[package_name + ".QtWidgets"] = QtWidgets
        if qtsvg_compat is not None:
            package.QtSvg = qtsvg_compat
            sys.modules[package_name + ".QtSvg"] = qtsvg_compat
        if qtuitools_compat is not None:
            package.QtUiTools = qtuitools_compat
            sys.modules[package_name + ".QtUiTools"] = qtuitools_compat


_ensure_qt_compat()

import os
import json
from pathlib import Path
from datetime import datetime
import subprocess

try:
    import FreeCAD as App  # type: ignore
    import FreeCADGui as Gui  # type: ignore
except ImportError:  # running outside FreeCAD (e.g. linting)
    App = None  # type: ignore[assignment]
    Gui = None  # type: ignore[assignment]

# ImportGui is used for export
try:
    import ImportGui
except Exception:
    ImportGui = None

# Part used to create simple GameStart marker (cone + base)
import Part

# PySide2 for GUI
from PySide2 import QtWidgets, QtCore


# -------------------------------
# Constants and parameters
# -------------------------------

PARAM_ROOT = "User parameter:BaseApp/Preferences/GameEngineExport"
if App is not None:
    _USER_APP_DIR = Path(App.getUserAppDataDir())
else:
    _USER_APP_DIR = Path.home()
DEFAULT_EXPORT_DIR = str(_USER_APP_DIR.joinpath("tmp"))
PRESETS_DIR_NAME = "presets"
APP_PREFIX = "[GAMEEXPORT]"

SCALE_TO_METERS = 0.001  # FreeCAD mm -> meters for X3D engines

# -------------------------------
# Utilities and logging
# -------------------------------

def log_info(msg):
    App.Console.PrintMessage(f"{APP_PREFIX}[INFO] {msg}\n")

def log_warn(msg):
    App.Console.PrintWarning(f"{APP_PREFIX}[WARN] {msg}\n")

def log_err(msg):
    App.Console.PrintError(f"{APP_PREFIX}[ERROR] {msg}\n")

def log_dbg(msg):
    # promote or demote as needed
    App.Console.PrintMessage(f"{APP_PREFIX}[DEBUG] {msg}\n")

def param_get(group=PARAM_ROOT):
    return App.ParamGet(group)

def get_param_str(key, default=""):
    return param_get().GetString(key, default)

def set_param_str(key, val):
    param_get().SetString(key, val)

def get_param_bool(key, default=False):
    return param_get().GetBool(key, default)

def set_param_bool(key, val):
    param_get().SetBool(key, val)

def ensure_dir(p):
    Path(p).mkdir(parents=True, exist_ok=True)


# -------------------------------
# Scene / selection helpers
# -------------------------------

def get_active_doc():
    doc = App.ActiveDocument
    if not doc:
        raise RuntimeError("No active document")
    return doc

def find_object_by_label(doc, label):
    for o in doc.Objects:
        if getattr(o, "Label", "") == label:
            return o
    return None

def collect_children_recursive(obj):
    """ Return flat list of children if obj is a group-like. Otherwise [obj]. """
    out = []
    if hasattr(obj, "OutList"):
        # For groups and features, OutList holds children in tree
        for c in obj.OutList:
            out.extend(collect_children_recursive(c))
        return out or [obj]
    return [obj]

def filter_by_categories(objects, cats):
    """
    cats: set like {"Walls","Floors","Roofs","Furniture","Lights","Cameras"}
    This is a placeholder. Adjust type detection to your model conventions.
    """
    out = []
    for o in objects:
        name = (getattr(o, "Name", "") or "").lower()
        label = (getattr(o, "Label", "") or "").lower()
        typeid = (getattr(o, "TypeId", "") or "").lower()
        # naive heuristics; replace with your groups/tags
        if "light" in label or "light" in name:
            if "Lights" in cats:
                out.append(o)
        elif "camera" in label or "camera" in name:
            if "Cameras" in cats:
                out.append(o)
        elif any(k in label for k in ["wall","muro","pared"]):
            if "Walls" in cats:
                out.append(o)
        elif any(k in label for k in ["floor","piso","slab","losa"]):
            if "Floors" in cats:
                out.append(o)
        elif any(k in label for k in ["roof","techo","cubierta"]):
            if "Roofs" in cats:
                out.append(o)
        else:
            if "Furniture" in cats:
                out.append(o)
    return out


# -------------------------------
# Materials (emissive) - placeholder
# -------------------------------

def apply_emissive_to_objects(objs, rgb=(1.0, 1.0, 1.0), transparency=0.0, shininess=0.2):
    """
    Placeholder. In FreeCAD, material assignment for export may depend on WB.
    The idea: bake color-like info so X3D Material.emissiveColor is meaningful.
    """
    for o in objs:
        try:
            # Example: set ViewObject properties; exporter may bake them
            if hasattr(o, "ViewObject"):
                vo = o.ViewObject
                # set a diffuse color to something, and mark emissive via custom props
                vo.ShapeColor = (rgb[0], rgb[1], rgb[2])
                vo.Transparency = int(max(0.0, min(1.0, transparency)) * 100.0)
                # custom property tag for later mapping if you implement deeper pipeline
                if not hasattr(o, "EmissiveTag"):
                    o.addProperty("App::PropertyString","EmissiveTag","GameEngine","emissive tag")
                o.EmissiveTag = f"{rgb[0]:.3f},{rgb[1]:.3f},{rgb[2]:.3f}|{shininess:.3f}"
            log_dbg(f"Applied emissive to: {o.Label}")
        except Exception as ex:
            log_warn(f"apply_emissive failed on {getattr(o,'Label','?')}: {ex}")


# -------------------------------
# Lights normalization - placeholder
# -------------------------------

def detect_lights(root_obj):
    """
    Return list of objects considered as lights (heuristic).
    """
    all_objs = collect_children_recursive(root_obj)
    return [o for o in all_objs if "light" in (getattr(o,"Label","")+getattr(o,"Name","")).lower()]

def normalize_lights(light_objs):
    """
    Placeholder: clamp intensity/range to sane defaults for CGE.
    """
    for o in light_objs:
        try:
            if not hasattr(o, "Intensity"):
                o.addProperty("App::PropertyFloat","Intensity","GameEngine","light intensity")
            if not hasattr(o, "Range"):
                o.addProperty("App::PropertyFloat","Range","GameEngine","light range")
            # clamp
            o.Intensity = max(0.0, min(5.0, getattr(o, "Intensity", 1.0)))
            o.Range = max(1.0, min(100.0, getattr(o, "Range", 10.0)))
            log_dbg(f"Normalized light: {o.Label} -> I={o.Intensity} R={o.Range}")
        except Exception as ex:
            log_warn(f"normalize_lights failed on {getattr(o,'Label','?')}: {ex}")


# -------------------------------
# GameStart marker: create simple cone arrow and store props
# -------------------------------

def create_gamestart(doc, name="GameStart"):
    """
    Create a simple marker (cone) with custom properties:
      Yaw, Pitch, Roll (deg), HeightOffset (m), FOV (deg)
    """
    if doc.getObject(name):
        log_info("GameStart already exists")
        return doc.getObject(name)

    cone = Part.makeCone(0, 100, 200)  # mm
    base = Part.makeCylinder(80, 10)   # base disk
    shape = Part.makeCompound([base, cone])
    obj = doc.addObject("Part::Feature", name)
    obj.Shape = shape
    obj.Label = "GameStart"
    # default placement: above origin
    obj.Placement.Base = App.Vector(0, 0, 1000)

    # custom properties
    obj.addProperty("App::PropertyFloat","Yaw","GameEngine","yaw deg").Yaw = 0.0
    obj.addProperty("App::PropertyFloat","Pitch","GameEngine","pitch deg").Pitch = 0.0
    obj.addProperty("App::PropertyFloat","Roll","GameEngine","roll deg").Roll = 0.0
    obj.addProperty("App::PropertyFloat","HeightOffset","GameEngine","height m").HeightOffset = 1.6
    obj.addProperty("App::PropertyFloat","FOV","GameEngine","fov deg").FOV = 60.0

    # view cosmetics
    if hasattr(obj, "ViewObject"):
        obj.ViewObject.ShapeColor = (1.0, 0.2, 0.2)
        obj.ViewObject.DisplayMode = "Flat Lines"

    doc.recompute()
    log_info("GameStart created")
    return obj


# -------------------------------
# Export helpers (X3D)
# -------------------------------

def export_objects_to_x3d(objs, filepath):
    """
    Use ImportGui.export to X3D (requires selection-like behavior).
    Note: FreeCAD exports meshes; ensure objects are exportable.
    """
    if ImportGui is None:
        raise RuntimeError("ImportGui module not available")
    if not objs:
        raise RuntimeError("No objects to export")

    # Ensure parent dir
    ensure_dir(Path(filepath).parent)

    try:
        ImportGui.export(objs, filepath)
        log_info(f"Exported X3D: {filepath}")
    except Exception as ex:
        log_err(f"Export failed: {ex}")
        raise

def make_baseline_export(root_obj, out_dir, base_name):
    """
    Export the whole root subtree as a baseline X3D to validate geometry/scale.
    """
    if root_obj is None:
        raise RuntimeError("Invalid scene root")
    all_objs = collect_children_recursive(root_obj)
    # optional filters could go here
    out_file = str(Path(out_dir).joinpath(f"{base_name}_baseline.x3d"))
    export_objects_to_x3d(all_objs, out_file)
    return out_file


# -------------------------------
# Presets IO
# -------------------------------

def get_presets_dir():
    base_dir = get_param_str("export_dir", DEFAULT_EXPORT_DIR)
    pdir = Path(base_dir).joinpath(PRESETS_DIR_NAME)
    ensure_dir(pdir)
    return pdir

def save_preset(name, data):
    p = get_presets_dir().joinpath(f"{name}.json")
    with open(p, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    log_info(f"Preset saved: {p}")

def load_preset(name):
    p = get_presets_dir().joinpath(f"{name}.json")
    if not p.exists():
        raise RuntimeError("Preset not found")
    with open(p, "r", encoding="utf-8") as f:
        return json.load(f)

# -------------------------------
# Castle Game Engine helpers
# -------------------------------

def is_valid_cge_executable(path_str):
    if not path_str:
        return False
    p = Path(path_str)
    return p.exists() and p.is_file()

def launch_cge(executable_path, exported_file):
    if not is_valid_cge_executable(executable_path):
        log_warn("No se encontro la ruta de CGE.")
        return False

    exported = Path(exported_file)
    if not exported.exists():
        log_warn("Archivo exportado no encontrado para lanzar CGE.")
        return False

    try:
        if os.name == "nt":
            subprocess.Popen([executable_path, str(exported)])
        else:
            subprocess.Popen([executable_path, str(exported)])
        return True
    except Exception as ex:
        log_err(f"Launch CGE failed: {ex}")
        return False

