    def _on_available_double_clicked(self, item):
        if item:
            self._transfer_available_items([item])

    def _on_selected_double_clicked(self, item):
        if item:
            self._transfer_selected_items([item])

    def _add_available_objects(self):
        items = self.lst_available_objects.selectedItems()
        if not items:
            self._set_status("Selecciona objetos disponibles para agregar.")
            return
        self._transfer_available_items(items)

    def _remove_selected_objects(self):
        items = self.lst_selected_objects.selectedItems()
        if not items:
            self._set_status("Selecciona objetos exportados para remover.")
            return
        self._transfer_selected_items(items)

    def _clear_object_selection(self):
        if not self._selected_object_names:
            self._set_status("No hay objetos seleccionados para limpiar.")
            return
        self._selected_object_names.clear()
        self._refresh_object_lists(silent=True)
        self._set_status("Seleccion de objetos limpiada.")

    def _transfer_available_items(self, items):
        added = 0
        non_geom = 0
        for item in items:
            name = item.data(QtCore.Qt.UserRole)
            if not name:
                continue
            if name not in self._selected_object_names:
                self._selected_object_names.add(name)
                added += 1
            if not item.data(QtCore.Qt.UserRole + 1):
                non_geom += 1
        if added:
            self._refresh_object_lists(silent=True)
        if added or non_geom:
            msg = f"{added} objetos agregados a la exportacion."
            if non_geom:
                msg += f" {non_geom} sin geometria directa (se usaran sus hijos)."
            self._set_status(msg)

    def _transfer_selected_items(self, items):
        removed = 0
        for item in items:
            name = item.data(QtCore.Qt.UserRole)
            if name and name in self._selected_object_names:
                self._selected_object_names.remove(name)
                removed += 1
        if removed:
            self._refresh_object_lists(silent=True)
            self._set_status(f"{removed} objetos removidos de la exportacion.")

    def _refresh_object_lists(self, silent=False):
        if not hasattr(self, "lst_available_objects"):
            return
        self.lst_available_objects.clear()
        self.lst_selected_objects.clear()

        label = self.ed_root.text().strip() if hasattr(self, "ed_root") else ""
        if not label:
            return
        root_obj = find_object_by_label(self.doc, label)
        if root_obj is None:
            return

        all_objs = collect_children_recursive(root_obj)
        selected_names = set(self._selected_object_names)
        valid_selected = set()
        seen = set()

        for obj in all_objs:
            name = getattr(obj, "Name", "")
            if not name or name in seen:
                continue
            seen.add(name)
            exportable = _object_has_shape(obj)
            text = getattr(obj, "Label", "") or name
            if not exportable:
                text = f"{text} [sin geometria]"
            item = QtWidgets.QListWidgetItem(text)
            item.setData(QtCore.Qt.UserRole, name)
            item.setData(QtCore.Qt.UserRole + 1, bool(exportable))

            if name in selected_names:
                self.lst_selected_objects.addItem(item)
                valid_selected.add(name)
            else:
                self.lst_available_objects.addItem(item)

        if valid_selected != selected_names:
            self._selected_object_names = valid_selected

        self._refresh_light_summary(valid_names=seen, silent=silent)

        if not silent:
            available_count = self.lst_available_objects.count()
            selected_count = self.lst_selected_objects.count()
            self._set_status(f"Lista de objetos actualizada. Disponibles: {available_count}, Exportados: {selected_count}")

    def _prompt_light_config(self, count=1, existing=None):
        dlg = QtWidgets.QDialog(self)
        dlg.setWindowTitle("Configurar luz")
        layout = QtWidgets.QFormLayout(dlg)

        combo = QtWidgets.QComboBox()
        combo.addItems(["PointLight", "SpotLight", "DirectionalLight"])
        spin_intensity = QtWidgets.QDoubleSpinBox()
        spin_intensity.setRange(0.0, 5.0)
        spin_intensity.setSingleStep(0.1)
        spin_intensity.setValue(1.0)

        spin_radius = QtWidgets.QDoubleSpinBox()
        spin_radius.setRange(0.1, 100.0)
        spin_radius.setSingleStep(0.5)
        spin_radius.setValue(5.0)

        spin_beam = QtWidgets.QDoubleSpinBox()
        spin_beam.setRange(0.1, 3.14)
        spin_beam.setSingleStep(0.1)
        spin_beam.setValue(0.7)

        spin_cut = QtWidgets.QDoubleSpinBox()
        spin_cut.setRange(0.1, 3.14)
        spin_cut.setSingleStep(0.1)
        spin_cut.setValue(1.0)

        if existing:
            idx = combo.findText(existing.get("type", "PointLight"))
            if idx >= 0:
                combo.setCurrentIndex(idx)
            spin_intensity.setValue(float(existing.get("intensity", 1.0)))
            spin_radius.setValue(float(existing.get("radius_m", 5.0)))
            spin_beam.setValue(float(existing.get("beam_width", 0.7)))
            spin_cut.setValue(float(existing.get("cut_off", 1.0)))

        info_lbl = QtWidgets.QLabel(f"Aplicar configuracion a {count} objeto(s). Intensidad 0-1 recomendada.")
        layout.addRow(info_lbl)
        layout.addRow("Tipo:", combo)
        layout.addRow("Intensidad:", spin_intensity)
        layout.addRow("Radio (m):", spin_radius)
        layout.addRow("Haz Spot (rad):", spin_beam)
        layout.addRow("Corte Spot (rad):", spin_cut)

        btn_box = QtWidgets.QDialogButtonBox(QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel)
        layout.addRow(btn_box)
        btn_box.accepted.connect(dlg.accept)
        btn_box.rejected.connect(dlg.reject)

        if dlg.exec_() != QtWidgets.QDialog.Accepted:
            return None
        return {
            "type": combo.currentText(),
            "intensity": float(spin_intensity.value()),
            "radius_m": float(spin_radius.value()),
            "beam_width": float(spin_beam.value()),
            "cut_off": float(spin_cut.value()),
        }

    def _add_lights_from_available(self):
        items = []
        if hasattr(self, "lst_available_objects"):
            items.extend(self.lst_available_objects.selectedItems())
        if hasattr(self, "lst_selected_objects"):
            items.extend(self.lst_selected_objects.selectedItems())
        if not items:
            self._set_status("Selecciona emisores en las listas para agregarlos como luces.")
            return
        names = []
        for item in items:
            name = item.data(QtCore.Qt.UserRole)
            if name:
                names.append(name)
        names = list(dict.fromkeys(names))
        if not names:
            self._set_status("No se encontraron nombres validos de objetos.")
            return
        config = self._prompt_light_config(count=len(names))
        if not config:
            return
        added = 0
        for name in names:
            if any(entry.get("name") == name for entry in self._light_entries):
                continue
            entry = {
                "name": name,
                "type": config["type"],
                "intensity": float(config["intensity"]),
                "radius_m": float(config["radius_m"]),
                "beam_width": float(config["beam_width"]),
                "cut_off": float(config["cut_off"]),
            }
            self._light_entries.append(entry)
            added += 1
        if added:
            self._refresh_light_summary()
            self._set_status(f"{added} luces agregadas.")
        else:
            self._set_status("Los objetos seleccionados ya estaban configurados como luces.")

    def _edit_light_entry(self, item=None):
        target_item = item
        if target_item is None:
            selected = self.lst_light_entries.selectedItems()
            if len(selected) != 1:
                self._set_status("Selecciona una luz para editar.")
                return
            target_item = selected[0]
        name = target_item.data(QtCore.Qt.UserRole)
        if not name:
            return
        entry = next((e for e in self._light_entries if e.get("name") == name), None)
        if entry is None:
            self._set_status("La luz seleccionada ya no existe.")
            return
        config = self._prompt_light_config(existing=entry)
        if not config:
            return
        entry.update({
            "type": config["type"],
            "intensity": float(config["intensity"]),
            "radius_m": float(config["radius_m"]),
            "beam_width": float(config["beam_width"]),
            "cut_off": float(config["cut_off"]),
        })
        self._refresh_light_summary()
        self._set_status("Luz actualizada.")

    def _remove_light_entries(self):
        selected = self.lst_light_entries.selectedItems()
        if not selected:
            self._set_status("Selecciona luces para quitar.")
            return
        names = {item.data(QtCore.Qt.UserRole) for item in selected if item.data(QtCore.Qt.UserRole)}
        before = len(self._light_entries)
        self._light_entries = [e for e in self._light_entries if e.get("name") not in names]
        removed = before - len(self._light_entries)
        if removed:
            self._refresh_light_summary()
            self._set_status(f"{removed} luces removidas.")
        else:
            self._set_status("No se removieron luces.")

    def _clear_light_entries(self):
        if not self._light_entries:
            self._set_status("No hay luces definidas.")
            return
        self._light_entries.clear()
        self._refresh_light_summary()
        self._set_status("Listado de luces limpiado.")

    def _refresh_light_summary(self, valid_names=None, silent=False):
        if not hasattr(self, "lst_light_entries"):
            return
        if valid_names is not None:
            before = len(self._light_entries)
            self._light_entries = [
                entry for entry in self._light_entries if entry.get("name") in valid_names
            ]
            if len(self._light_entries) != before and not silent:
                self._set_status("Se eliminaron luces cuyos objetos no existen.")
        self.lst_light_entries.clear()
        for entry in self._light_entries:
            name = entry.get("name")
            obj = self.doc.getObject(name) if name else None
            label = getattr(obj, "Label", name) if obj else name
            text = f"{entry.get('type','PointLight')} | {label} | I={entry.get('intensity',1.0):.2f}"
            item = QtWidgets.QListWidgetItem(text)
            item.setData(QtCore.Qt.UserRole, name)
            self.lst_light_entries.addItem(item)
        if not silent:
            self._set_status(f"Luces definidas: {len(self._light_entries)}")

    def _gather_category_selection(self):
        categories = set()
        if self.chk_walls.isChecked(): categories.add("Walls")
        if self.chk_floors.isChecked(): categories.add("Floors")
        if self.chk_roofs.isChecked(): categories.add("Roofs")
        if self.chk_furniture.isChecked(): categories.add("Furniture")
        if self.chk_lights.isChecked(): categories.add("Lights")
        if self.chk_cameras.isChecked(): categories.add("Cameras")
        return categories

    def _build_export_pool(self):
        if self._selected_object_names:
            pool = []
            missing = []
            for name in list(self._selected_object_names):
                obj = self.doc.getObject(name)
                if obj is None:
                    missing.append(name)
                    continue
                pool.extend(collect_children_recursive(obj))
            if missing:
                for name in missing:
                    log_warn(f"Objeto seleccionado no encontrado: {name}")
                for name in missing:
                    self._selected_object_names.discard(name)
                self._refresh_object_lists(silent=True)
            if not pool:
                raise RuntimeError("Los objetos seleccionados ya no existen en el documento.")
            return _dedupe_objects(pool)
        root_obj = self._resolve_root()
        return _dedupe_objects(collect_children_recursive(root_obj))

    def _prepare_export_objects(self, categories):
        pool = self._build_export_pool()
        filtered = filter_by_categories(pool, categories)
        gs_name = self.ed_gamestart.text().strip() if hasattr(self, "ed_gamestart") else ""
        if gs_name:
            filtered = [
                o for o in filtered
                if getattr(o, "Name", "") != gs_name and getattr(o, "Label", "") != gs_name
            ]
        exportables = [o for o in filtered if _object_has_shape(o)]
        if not exportables:
            raise RuntimeError("No se encontraron objetos exportables en la seleccion actual.")
        return _dedupe_objects(exportables)

